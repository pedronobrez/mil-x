<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net48;net8.0</TargetFrameworks>
    <RootNamespace>CompMs.MsdialCore</RootNamespace>
    <Configurations>Debug;Release;Debug vendor unsupported;Release vendor unsupported</Configurations>
    <LangVersion>12</LangVersion>
    <Nullable>annotations</Nullable>
    <!-- MIL-X: path of the open raw data project (override with -p:MilXRawDataProject=...) -->
    <DefineConstants Condition="'$(UseOpenRawData)' == 'true'">$(DefineConstants);MILX_SQLITE</DefineConstants>
    <MilXRawDataProject Condition="'$(MilXRawDataProject)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\milx\src\MilX.RawData\MilX.RawData.csproj</MilXRawDataProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Accord" Version="3.8.0" />
    <PackageReference Include="Accord.Math" Version="3.8.0" />
    <PackageReference Include="Accord.Statistics" Version="3.8.0" />
    <!-- MIL-X: the closed RawDataHandler package is only referenced when UseOpenRawData is not set.
         Build with -p:UseOpenRawData=true to use the open, cross-platform MilX.RawData project instead. -->
	  <PackageReference Include="RawDataHandler" Version="1.3.9725.140" Condition="'$(UseOpenRawData)' != 'true' AND '$(Configuration)'=='Release'" />
	  <PackageReference Include="RawDataHandler" Version="1.3.*-*" Condition="'$(UseOpenRawData)' != 'true' AND '$(Configuration)'=='Debug'" />
	  <PackageReference Include="RawDataHandler-Vendor-UnSupported" Version="1.3.*-*" Condition="'$(UseOpenRawData)' != 'true' AND '$(Configuration)'=='Debug vendor unsupported'" />
	  <PackageReference Include="RawDataHandler-Vendor-UnSupported" Version="1.3.*" Condition="'$(UseOpenRawData)' != 'true' AND '$(Configuration)'=='Release vendor unsupported'" />
	  <PackageReference Include="System.Data.SQLite.Core" Version="1.0.112.2" Condition="'$(UseOpenRawData)' != 'true'" />
	  <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" Condition="'$(UseOpenRawData)' == 'true'" />
    <PackageReference Include="System.IO.Compression" Version="4.3.0" />
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
	  <InternalsVisibleTo Include="MsdialCoreTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Common\CommonStandard\CommonStandard.csproj" />
    <ProjectReference Include="..\..\Common\spectra-hash\splash\Splash.csproj" />
    <ProjectReference Include="$(MilXRawDataProject)" Condition="'$(UseOpenRawData)' == 'true'" />
  </ItemGroup>

</Project>
