<Project>
  <!--
    The one place the OpenDIAL version lives. The application shows it in About and in the manual,
    scripts/make-app-bundle.sh stamps it into Info.plist, and ManualTests requires the manual's
    "Versions" page to name it, so a release without its notes does not build green.
  -->
  <PropertyGroup>
    <Version>0.9.0</Version>
    <InformationalVersion>0.9.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
