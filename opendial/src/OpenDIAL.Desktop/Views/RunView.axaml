<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenDIAL.Desktop.ViewModels"
             x:Class="OpenDIAL.Desktop.Views.RunView"
             x:DataType="vm:RunViewModel">
  <DockPanel Margin="14,10">
    <Border DockPanel.Dock="Top" Classes="card">
      <StackPanel Spacing="6">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelCommand}" MinWidth="90" />
          <StackPanel>
            <TextBlock Classes="h1" Text="Processing" />
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Text="{Binding Stage}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding CurrentFile}" Classes="muted" />
            </StackPanel>
          </StackPanel>
        </DockPanel>
        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Height="14" ShowProgressText="True" />
        <TextBlock Text="{Binding StatusText}" Classes="muted" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <Border Classes="card" Padding="0">
      <ListBox x:Name="LogList" ItemsSource="{Binding LogLines}" FontFamily="Menlo, Consolas, monospace" FontSize="11.5" SelectionMode="Multiple">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="MinHeight" Value="18" />
          </Style>
        </ListBox.Styles>
      </ListBox>
    </Border>
  </DockPanel>
</UserControl>
