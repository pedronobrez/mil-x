<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenDIAL.Desktop.ViewModels"
             xmlns:c="using:OpenDIAL.Desktop.Controls"
             xmlns:views="using:OpenDIAL.Desktop.Views"
             x:Class="OpenDIAL.Desktop.Views.AnalyticsView"
             x:DataType="vm:AnalyticsViewModel">
  <!--
    The review workspace, laid out the way an MS-DIAL review pass runs: the ion table is the spine
    on the left, the evidence for the selected feature is on the right, and the verdict is one
    keystroke away in the curation strip between them.
  -->
  <!-- the review keys are bound on the windows (MainWindow, IonTableWindow), not here: a control's
       bindings fire only while the focus is inside it, and a reviewer's focus is wherever it last was -->

  <DockPanel>
    <!-- toolbar -->
    <Border DockPanel.Dock="Top" Classes="band">
      <DockPanel>
        <!-- the buttons are docked first so the summary, which can be a sentence after a save,
             takes what is left and trims instead of drawing over them -->
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="2">
          <Button x:Name="ProcessBatch" Classes="tool strong" Content="Process batch" Command="{Binding $parent[Window].DataContext.ProcessBatchCommand}" ToolTip.Tip="Run the pipeline on the current batch (Cmd+R)" />
          <Button Classes="tool" Content="Re-export…" Command="{Binding $parent[Window].DataContext.ReexportCommand}" IsEnabled="{Binding HasResults}" />
          <Button Classes="tool" Content="Export to OpenQuant…" Command="{Binding $parent[Window].DataContext.ExportOpenQuantCommand}" IsEnabled="{Binding HasResults}" ToolTip.Tip="Write the listed features as an OpenQuant component CSV (precursor, fragment, RT window)" />
          <Button Classes="tool" Content="Export reviewed table…" Command="{Binding $parent[Window].DataContext.ExportReviewedTableCommand}" IsEnabled="{Binding HasResults}" ToolTip.Tip="Write the features the filter is showing, with their tags, comments and hand edits as columns" />
          <Button Classes="tool" Content="Open output folder" Command="{Binding OpenOutputFolderCommand}" IsEnabled="{Binding HasResults}" />
          <Rectangle Classes="vsep" />
          <Button x:Name="SaveReview" Classes="tool" Command="{Binding SaveCurationCommand}" IsEnabled="{Binding HasResults}"
                  ToolTip.Tip="Write the review to &lt;alignment&gt;_tags.xml, the same file MS-DIAL reads and writes">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="Save review" VerticalAlignment="Center" />
              <Ellipse Width="7" Height="7" Fill="{DynamicResource OdAccent}" VerticalAlignment="Center" IsVisible="{Binding CurationDirty}" />
            </StackPanel>
          </Button>
        </StackPanel>
        <TextBlock Classes="muted" Text="{Binding Summary}" VerticalAlignment="Center" Margin="12,0,4,0" TextAlignment="Right" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Summary}" />
      </DockPanel>
    </Border>

    <!-- filter band -->
    <Border DockPanel.Dock="Top" Classes="band" IsVisible="{Binding HasResults}">
      <DockPanel>
        <StackPanel x:Name="FilterCounts" DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Border Classes="count" ToolTip.Tip="confirmed"><TextBlock Text="{Binding ConfirmedCount}" /></Border>
          <Border Classes="badge" ToolTip.Tip="misannotation"><TextBlock Classes="badge" Text="{Binding RejectedCount}" /></Border>
          <TextBlock Classes="muted" Text="{Binding TableSummary}" VerticalAlignment="Center" Margin="6,0,4,0" MaxWidth="230" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <!--
          The filters are wider than a laptop screen once they are all here, and a horizontal
          StackPanel does not give way: it drew straight over the counts on the right. Inside a
          scroller it is held to the space that is actually left.
        -->
        <ScrollViewer x:Name="FilterScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBox x:Name="FilterBox" Text="{Binding FilterText}" Watermark="name, ontology, adduct, comment, id…" Width="230" />
          <TextBlock Classes="label" Text="m/z" Margin="6,0,0,0" />
          <TextBox Text="{Binding MzFrom}" Watermark="from" Width="72" />
          <TextBox Text="{Binding MzTo}" Watermark="to" Width="72" />
          <TextBlock Classes="label" Text="RT" Margin="6,0,0,0" />
          <TextBox Text="{Binding RtFrom}" Watermark="from" Width="62" />
          <TextBox Text="{Binding RtTo}" Watermark="to" Width="62" />
          <ComboBox Classes="compact" ItemsSource="{x:Static vm:AnalyticsViewModel.AnnotationFilters}" SelectedItem="{Binding AnnotationFilter}" Width="120" Margin="6,0,0,0" ToolTip.Tip="Annotation confidence" />
          <ComboBox Classes="compact" ItemsSource="{Binding Ontologies}" SelectedItem="{Binding OntologyFilter}" Width="140" ToolTip.Tip="Lipid class / ontology" />
          <ComboBox Classes="compact" ItemsSource="{x:Static vm:AnalyticsViewModel.TagFilters}" SelectedItem="{Binding TagFilter}" Width="170" ToolTip.Tip="Review state" />
          <CheckBox Classes="compact" Content="MS/MS only" IsChecked="{Binding MsmsOnly}" Margin="4,0,0,0" />
          <CheckBox Classes="compact" Content="Molecular ion" IsChecked="{Binding MolecularIonOnly}" ToolTip.Tip="Drop the features the run marked as isotopes of another" />
          <CheckBox Classes="compact" Content="Hand-edited" IsChecked="{Binding ManuallyModifiedOnly}" ToolTip.Tip="Only features whose annotation or integration was changed by hand" />
        </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Grid x:Name="ReviewGrid" ColumnDefinitions="1.15*,6,1.35*" Margin="8">
      <!-- ================= ion table ================= -->
      <!-- torn off into its own window, its column and the splitter collapse (see code-behind), so the
           peaks and the spectrum take the whole width rather than leaving a hole where it was -->
      <views:IonTableView Grid.Column="0" x:Name="InlineIonTable" IsVisible="{Binding !IonTableDetached}" />

      <GridSplitter Grid.Column="1" Classes="vertical" ResizeDirection="Columns" IsVisible="{Binding !IonTableDetached}" />

      <!-- where the table lands when its window is dragged back over the main one -->
      <Border x:Name="DockPreview" Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Left" IsVisible="{Binding IonTableDockPreview}"
              Background="{DynamicResource OdAccentSoft}" BorderBrush="{DynamicResource OdAccent}" BorderThickness="2" CornerRadius="8" Opacity="0.85" ZIndex="10" IsHitTestVisible="False">
        <TextBlock Text="Release to dock the ion table here" Foreground="{DynamicResource OdAccent}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="24" />
      </Border>

      <!-- ================= evidence for the selected feature ================= -->
      <Panel Grid.Column="2">
        <Grid RowDefinitions="Auto,Auto,*">
          <!-- identity -->
          <Border Grid.Row="0" Padding="2,0,2,6">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Border Classes="chip" IsVisible="{Binding SelectedRow.IsManual}"><TextBlock Text="hand-picked" /></Border>
                <Border Classes="chip"><TextBlock Text="{Binding SelectedRow.Level}" /></Border>
              </StackPanel>
              <StackPanel Spacing="1" VerticalAlignment="Center">
                <TextBlock Classes="title" Text="{Binding SpotTitle}" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="hint" Text="{Binding SpotDetail}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DockPanel>
          </Border>

          <!-- verdict -->
          <Border Grid.Row="1" Classes="panel" Padding="10,8" Margin="0,0,0,6">
            <StackPanel Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Classes="tool strong" Content="Confirm ▸" Command="{Binding ConfirmAndNextCommand}" ToolTip.Tip="Tag Confirmed and move to the next feature (Alt+C)" />
                <Button Classes="tool" Content="Reject ▸" Command="{Binding RejectAndNextCommand}" ToolTip.Tip="Tag Misannotation and move to the next feature (Alt+X)" />
                <Rectangle Classes="vsep" />
                <Button Classes="tool" Content="Confirmed" Command="{Binding ToggleTagCommand}" CommandParameter="1" Classes.on="{Binding SelectedRow.IsConfirmed}" ToolTip.Tip="Ctrl+1" />
                <Button Classes="tool" Content="Low quality" Command="{Binding ToggleTagCommand}" CommandParameter="2" Classes.on="{Binding SelectedRow.IsLowQuality}" ToolTip.Tip="Ctrl+2 · the MS/MS is too weak to judge" />
                <Button Classes="tool" Content="Misannotation" Command="{Binding ToggleTagCommand}" CommandParameter="3" Classes.on="{Binding SelectedRow.IsRejected}" ToolTip.Tip="Ctrl+3" />
                <Button Classes="tool" Content="Coelution" Command="{Binding ToggleTagCommand}" CommandParameter="4" Classes.on="{Binding SelectedRow.IsCoelution}" ToolTip.Tip="Ctrl+4 · mixed spectrum from co-eluting compounds" />
                <Button Classes="tool" Content="Overannotation" Command="{Binding ToggleTagCommand}" CommandParameter="5" Classes.on="{Binding SelectedRow.IsOverannotation}" ToolTip.Tip="Ctrl+5 · isotope, adduct or in-source fragment of another feature" />
                <Button Classes="tool" Content="Clear" Command="{Binding ClearTagsCommand}" ToolTip.Tip="Remove every tag (Ctrl+0)" />
              </StackPanel>
              <TextBox Watermark="Comment on this feature…" Text="{Binding SelectedRow.Comment, Mode=TwoWay}" />
            </StackPanel>
          </Border>

          <!-- evidence: the peak in every sample above, the spectrum and the rest below.
               A reviewer confirms an analyte from the chromatogram and the product spectrum
               together, so both are on screen the moment a result opens; the other views are
               tabs of the lower panel and never hide the peaks. -->
          <Grid Grid.Row="2" RowDefinitions="1.15*,6,*">
            <Border Grid.Row="0" Classes="panel" Padding="6">
                <DockPanel>
                  <Border DockPanel.Dock="Top" Padding="0,0,0,6">
                    <DockPanel>
                    <TextBlock Classes="eyebrow" Text="PEAKS" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip.Tip="The feature's chromatogram in every sample" />
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                      <TextBlock Classes="label" Text="Grid" Margin="0,0,6,0" VerticalAlignment="Center" />
                      <NumericUpDown Value="{Binding Columns}" Minimum="1" Maximum="8" Increment="1" FormatString="0" Width="100" MinWidth="100" MinHeight="26" HorizontalContentAlignment="Center" ToolTip.Tip="Columns of the grid" Margin="0,0,6,0" />
                      <NumericUpDown Value="{Binding Rows}" Minimum="1" Maximum="6" Increment="1" FormatString="0" Width="100" MinWidth="100" MinHeight="26" HorizontalContentAlignment="Center" ToolTip.Tip="Rows of the grid" Margin="0,0,6,0" />
                      <CheckBox Classes="compact" Content="Same Y" IsChecked="{Binding SameY}" Margin="6,0,6,0" VerticalAlignment="Center" />
                      <CheckBox Classes="compact" Content="Link X" IsChecked="{Binding LinkX}" Margin="0,0,6,0" VerticalAlignment="Center" />
                      <ComboBox Classes="compact" ItemsSource="{x:Static vm:AnalyticsViewModel.ZoomModes}" SelectedItem="{Binding ZoomMode}" Width="140" Margin="0,0,6,0" VerticalAlignment="Center" />
                      <Button Classes="tool" Content="Magnify" Click="OnMagnifySelected" ToolTip.Tip="Enlarge the selected sample (double-click a panel does the same)" VerticalAlignment="Center" />
                      <Button Classes="icon" Content="◀" Command="{Binding PreviousPageCommand}" Margin="6,0,0,0" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding PageLabel}" VerticalAlignment="Center" MinWidth="36" TextAlignment="Center" />
                      <Button Classes="icon" Content="▶" Command="{Binding NextPageCommand}" VerticalAlignment="Center" />
                    </WrapPanel>
                    </DockPanel>
                  </Border>
                  <Border DockPanel.Dock="Top" Classes="hairline-bottom" Padding="0,0,0,6" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <TextBlock Classes="eyebrow" Text="INTEGRATE" Margin="0,0,4,0" VerticalAlignment="Center" />
                      <TextBox x:Name="IntegrateFrom" Text="{Binding IntegrationFrom}" Watermark="from" Width="80" />
                      <TextBlock Classes="label" Text="to" VerticalAlignment="Center" />
                      <TextBox x:Name="IntegrateTo" Text="{Binding IntegrationTo}" Watermark="to" Width="80" />
                      <TextBlock Classes="label" Text="min" VerticalAlignment="Center" Margin="0,0,4,0" />
                      <Button x:Name="ApplyToAll" Classes="tool strong" Content="Apply to all" Command="{Binding ReintegrateAllCommand}" ToolTip.Tip="Re-integrate this feature over the window in every sample" />
                      <Button Classes="tool" Content="This sample" Command="{Binding ReintegrateSampleCommand}" ToolTip.Tip="Re-integrate only the sample in focus" />
                      <Button Classes="tool" Content="Reset" Command="{Binding ResetIntegrationWindowCommand}" ToolTip.Tip="Put the current peak's own boundaries back in the boxes" />
                      <Rectangle Classes="vsep" />
                      <Button x:Name="SplitIsomer" Classes="tool" Content="Split isomer" Command="{Binding SplitIsomerCommand}" ToolTip.Tip="Copy the feature so two co-eluting compounds can be integrated and named apart" />
                      <TextBlock Classes="hint" Text="{Binding IntegrationHint}" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Border>
                  <Panel>
                    <ItemsControl ItemsSource="{Binding Panels}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <UniformGrid Columns="{Binding $parent[ItemsControl].DataContext.Columns}" Rows="{Binding $parent[ItemsControl].DataContext.EffectiveRows}" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ReviewPanelViewModel">
                          <Border Margin="3" BorderBrush="{DynamicResource OdLine}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                            <c:LineChart Compact="True" Series="{Binding Series}" Windows="{Binding Windows}" Title="{Binding Title}" MarkerX="{Binding MarkerRt}"
                                         FixedXMin="{Binding FixedXMin}" FixedXMax="{Binding FixedXMax}" FixedYMax="{Binding FixedYMax}" IsHighlighted="{Binding IsSelected}"
                                         AutoZoomToHighlight="False" ShowLegend="False" PointClicked="OnPanelClicked" ChartDoubleClicked="OnPanelDoubleClicked" RangeSelected="OnRangeSelected" />
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="faint" Text="Select a feature in the ion table to review its peak in every sample." HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !Panels.Count}" />
                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsGridBusy}" VerticalAlignment="Top" Height="3" Margin="2" />
                  </Panel>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Row="1" Classes="horizontal" ResizeDirection="Rows" />
            <Border Grid.Row="2" Classes="panel">
            <TabControl x:Name="ResultTabs" Classes="panel-tabs" Margin="6,0,6,6">
              <!-- product spectrum against the library -->
              <TabItem Header="MS/MS">
                <Grid Margin="0,6,0,0" ColumnDefinitions="*,260">
                  <c:SpectrumChart Grid.Column="0" Peaks="{Binding Ms2Peaks}" ReferencePeaks="{Binding ReferencePeaks}" PrecursorMz="{Binding Ms2Precursor}" Title="{Binding Ms2Title}" />
                  <Border Grid.Column="1" Classes="hairline-left" Padding="12,4,4,4">
                    <StackPanel Spacing="6">
                      <TextBlock Classes="eyebrow" Text="MATCH SCORES" Margin="0,0,0,2" />
                      <ItemsControl ItemsSource="{Binding ScoreRows}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ScoreRow">
                            <DockPanel Margin="0,2">
                              <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontFamily="{DynamicResource OdMonoFont}" />
                              <TextBlock Classes="muted" Text="{Binding Metric}" />
                            </DockPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Classes="hint" TextWrapping="Wrap"
                                 Text="Dot products, matched-peak count and mass error for every candidate are in the Candidates tab, where another one can be chosen." />
                    </StackPanel>
                  </Border>
                </Grid>
              </TabItem>

              <!-- MS1 isotope envelope -->
              <TabItem Header="Isotopes">
                <DockPanel Margin="0,6,0,0">
                  <TextBlock DockPanel.Dock="Bottom" Classes="hint" Margin="4,6,4,0" TextWrapping="Wrap"
                             Text="An isotope envelope that does not match the formula, or a monoisotopic ion that is not the base peak, usually means the feature is an isotope or an adduct of something else. Tag it Overannotation." />
                  <c:SpectrumChart Peaks="{Binding IsotopePeaks}" PrecursorMz="{Binding Ms2Precursor}" Title="{Binding IsotopeTitle}" />
                </DockPanel>
              </TabItem>

              <!-- the alternatives to the reported annotation -->
              <TabItem Header="Candidates">
                <DockPanel Margin="0,6,0,0">
                  <Border DockPanel.Dock="Top" Classes="hairline-bottom" Padding="0,0,0,6" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <TextBlock Classes="eyebrow" Text="SEARCH LIBRARY" Margin="0,0,4,0" VerticalAlignment="Center" />
                      <TextBlock Classes="label" Text="MS1" VerticalAlignment="Center" />
                      <TextBox Text="{Binding SearchMs1Tolerance}" Width="66" ToolTip.Tip="Precursor tolerance in Da" />
                      <TextBlock Classes="label" Text="MS2" VerticalAlignment="Center" />
                      <TextBox Text="{Binding SearchMs2Tolerance}" Width="66" ToolTip.Tip="Fragment tolerance in Da" />
                      <CheckBox Classes="compact" Content="RT" IsChecked="{Binding SearchUseRt}" ToolTip.Tip="Also require the reference retention time to match" />
                      <TextBox Text="{Binding SearchRtTolerance}" Width="56" IsEnabled="{Binding SearchUseRt}" ToolTip.Tip="Retention tolerance in minutes" />
                      <Button Classes="tool strong" Content="Search" Command="{Binding SearchLibraryCommand}" IsEnabled="{Binding !IsSearching}" />
                      <Button Classes="tool" Content="Back to the run's matches" Command="{Binding RestoreCandidatesCommand}" IsVisible="{Binding ShowingSearchResults}" />
                      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsSearching}" Width="80" Height="3" VerticalAlignment="Center" />
                    </StackPanel>
                  </Border>
                  <Border DockPanel.Dock="Bottom" Padding="0,6,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Button Classes="tool strong" Content="Use this annotation" Command="{Binding UseSelectedCandidateCommand}" ToolTip.Tip="Replace the reported name with the selected candidate" />
                      <Button Classes="tool" Content="Back to the automatic name" Command="{Binding ResetAnnotationCommand}" />
                      <TextBlock Classes="hint" VerticalAlignment="Center" Margin="8,0,0,0" Text="{Binding SearchHint}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Border>
                  <DataGrid ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Candidate" Binding="{Binding Name}" Width="2*" />
                      <DataGridTextColumn Header="Total" Binding="{Binding TotalScore, StringFormat={}{0:F3}}" Width="70" />
                      <DataGridTextColumn Header="Dot" Binding="{Binding WeightedDotProduct, StringFormat={}{0:F3}}" Width="70" />
                      <DataGridTextColumn Header="Reverse" Binding="{Binding ReverseDotProduct, StringFormat={}{0:F3}}" Width="80" />
                      <DataGridTextColumn Header="Matched" Binding="{Binding MatchedPeaksCount, StringFormat={}{0:F0}}" Width="80" />
                      <DataGridTextColumn Header="Matched %" Binding="{Binding MatchedPeaksPercentage, StringFormat={}{0:F2}}" Width="90" />
                      <DataGridTextColumn Header="Mass sim." Binding="{Binding MassSimilarity, StringFormat={}{0:F3}}" Width="90" />
                      <DataGridCheckBoxColumn Header="Class" Binding="{Binding IsLipidClassMatch}" Width="60" />
                      <DataGridCheckBoxColumn Header="Chains" Binding="{Binding IsLipidChainsMatch}" Width="66" />
                      <DataGridCheckBoxColumn Header="sn" Binding="{Binding IsLipidPositionMatch}" Width="50" />
                      <DataGridCheckBoxColumn Header="Reported" Binding="{Binding IsRepresentative}" Width="*" />
                    </DataGrid.Columns>
                  </DataGrid>
                </DockPanel>
              </TabItem>

              <!-- abundance per sample, grouped by class -->
              <TabItem Header="Abundance">
                <DockPanel Margin="0,6,0,0">
                  <TextBlock DockPanel.Dock="Bottom" Classes="hint" Margin="4,6,4,0" TextWrapping="Wrap"
                             Text="One bar per injection, coloured by class. A feature as high in the blanks as in the samples is background; one that varies wildly across the quality-control injections is not quantifiable." />
                  <c:BarChart Items="{Binding SampleBars}" />
                </DockPanel>
              </TabItem>

              <!-- the whole filtered set as a map, for class trends -->
              <TabItem Header="Feature map">
                <DockPanel Margin="0,6,0,0">
                  <TextBlock DockPanel.Dock="Top" Classes="hint" Margin="4,0,4,6" Text="{Binding FeatureMapLabel}" />
                  <TextBlock DockPanel.Dock="Bottom" Classes="hint" Margin="4,6,4,0" TextWrapping="Wrap"
                             Text="Filter to one lipid class: on a reversed-phase column its members fall on a line, retention rising with acyl carbon number and falling with each double bond. A member off that line is the first to re-examine. Click a dot to jump to it in the ion table." />
                  <c:ScatterChart Items="{Binding FeatureMap}" SelectedItem="{Binding SelectedFeaturePoint, Mode=TwoWay}" XLabel="Retention time (min)" YLabel="m/z" />
                </DockPanel>
              </TabItem>

              <!-- per-sample numbers -->
              <TabItem Header="Samples">
                <DataGrid Margin="0,6,0,0" ItemsSource="{Binding SampleRows}" SelectedItem="{Binding SelectedSampleRow, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Order}" Width="40" />
                    <DataGridTextColumn Header="Sample" Binding="{Binding Sample}" Width="180" />
                    <DataGridTextColumn Header="Class" Binding="{Binding Class}" Width="90" />
                    <DataGridTextColumn Header="Type" Binding="{Binding SampleType}" Width="80" />
                    <DataGridTextColumn Header="RT (min)" Binding="{Binding Rt, Converter={x:Static views:Converters.Number}, ConverterParameter=F3}" Width="90" />
                    <DataGridTextColumn Header="m/z" Binding="{Binding Mz, Converter={x:Static views:Converters.Number}, ConverterParameter=F4}" Width="90" />
                    <DataGridTextColumn Header="Height" Binding="{Binding Height, Converter={x:Static views:Converters.Number}, ConverterParameter=N0}" Width="100" />
                    <DataGridTextColumn Header="Area" Binding="{Binding Area, Converter={x:Static views:Converters.Number}, ConverterParameter=N0}" Width="100" />
                    <DataGridTextColumn Header="S/N" Binding="{Binding SignalToNoise, Converter={x:Static views:Converters.Number}, ConverterParameter=N0}" Width="90" />
                    <DataGridTextColumn Header="Start" Binding="{Binding RtLeft, Converter={x:Static views:Converters.Number}, ConverterParameter=F3}" Width="80" />
                    <DataGridTextColumn Header="End" Binding="{Binding RtRight, Converter={x:Static views:Converters.Number}, ConverterParameter=F3}" Width="80" />
                    <DataGridTextColumn Header="Gap-filled" Binding="{Binding GapFilled}" Width="*" />
                  </DataGrid.Columns>
                </DataGrid>
              </TabItem>

              <TabItem Header="Statistics">
                <DataGrid Margin="0,6,0,0" ItemsSource="{Binding ClassStats}" AutoGenerateColumns="False" IsReadOnly="True">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Class" Binding="{Binding Class}" Width="140" />
                    <DataGridTextColumn Header="n" Binding="{Binding N}" Width="50" />
                    <DataGridTextColumn Header="Mean height" Binding="{Binding Mean, StringFormat={}{0:N0}}" Width="110" />
                    <DataGridTextColumn Header="SD" Binding="{Binding Sd, StringFormat={}{0:N0}}" Width="100" />
                    <DataGridTextColumn Header="% CV" Binding="{Binding Cv, StringFormat={}{0:F1}}" Width="70" />
                    <DataGridTextColumn Header="Min" Binding="{Binding Min, StringFormat={}{0:N0}}" Width="100" />
                    <DataGridTextColumn Header="Max" Binding="{Binding Max, StringFormat={}{0:N0}}" Width="100" />
                    <DataGridTextColumn Header="Mean area" Binding="{Binding AreaMean, StringFormat={}{0:N0}}" Width="*" />
                  </DataGrid.Columns>
                </DataGrid>
              </TabItem>

              <TabItem Header="Trend">
                <DockPanel Margin="0,6,0,0">
                  <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
                    <TextBlock Classes="label" Text="Y" />
                    <ComboBox Classes="compact" ItemsSource="{x:Static vm:AnalyticsViewModel.MetricColumns}" SelectedItem="{Binding MetricY}" Width="110" />
                    <TextBlock Classes="label" Text="X" Margin="10,0,4,0" />
                    <ComboBox Classes="compact" ItemsSource="{x:Static vm:AnalyticsViewModel.MetricXColumns}" SelectedItem="{Binding MetricX}" Width="150" />
                    <TextBlock Classes="hint" Text="Coloured by class · click a point to select the sample" VerticalAlignment="Center" Margin="10,0,0,0" />
                  </StackPanel>
                  <c:ScatterChart Items="{Binding MetricPoints}" SelectedItem="{Binding SelectedMetricPoint, Mode=TwoWay}" XLabel="{Binding MetricX}" YLabel="{Binding MetricY}" Connect="True" />
                </DockPanel>
              </TabItem>
            </TabControl>
            </Border>
          </Grid>
        </Grid>

        <!-- magnified panel overlay -->
        <Border Classes="panel" IsVisible="{Binding MagnifiedPanel, Converter={x:Static views:Converters.IsNotNull}}" Margin="0" Background="{DynamicResource OdSurface}">
          <DockPanel DataContext="{Binding MagnifiedPanel}">
            <Border DockPanel.Dock="Top" Classes="hairline-bottom" Padding="12,8">
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="Close" Command="{Binding $parent[UserControl].DataContext.CloseMagnifiedCommand}" />
                <TextBlock Classes="title" Text="{Binding Title}" VerticalAlignment="Center" />
              </DockPanel>
            </Border>
            <c:LineChart Series="{Binding Series}" Windows="{Binding Windows}" MarkerX="{Binding MarkerRt}" FixedXMin="{Binding FixedXMin}" FixedXMax="{Binding FixedXMax}" AutoZoomToHighlight="False" ShowLegend="False" Margin="4" RangeSelected="OnRangeSelected" />
          </DockPanel>
        </Border>
      </Panel>
    </Grid>
  </DockPanel>
</UserControl>
