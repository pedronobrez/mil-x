<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenDIAL.Desktop.ViewModels"
             x:Class="OpenDIAL.Desktop.Views.ProjectView"
             x:DataType="vm:ProjectViewModel">
  <DockPanel>
    <!-- bottom action bar -->
    <Border DockPanel.Dock="Bottom" Padding="12,8" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="▶  Run pipeline" Classes="accent" MinWidth="150" HorizontalContentAlignment="Center"
                IsEnabled="{Binding CanRun}" Command="{Binding $parent[Window].DataContext.RunPipelineCommand}" />
        <CheckBox DockPanel.Dock="Right" Margin="0,0,16,0" Content="Save project (.mdproject)" IsChecked="{Binding SaveProject}" />
        <TextBlock Text="{Binding StatusMessage}" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" />
      </DockPanel>
    </Border>

    <ScrollViewer>
      <StackPanel Margin="14,10,14,10" MaxWidth="1400">

        <!-- files -->
        <Border Classes="card">
          <StackPanel>
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                <Button Content="Add files…" Command="{Binding AddFilesCommand}" />
                <Button Content="Add folder…" Command="{Binding AddFolderCommand}" />
                <Button Content="Remove" Command="{Binding RemoveSelectedCommand}" />
                <Button Content="Clear" Command="{Binding ClearFilesCommand}" />
              </StackPanel>
              <TextBlock Classes="h1" Text="Input files" />
            </DockPanel>
            <TextBlock Classes="muted" Margin="0,0,0,6">
              Accepts .mzML, .abf, .cdf, .ibf directly. Vendor formats (.raw, .d, .wiff, .wiff2) require the msconvert bridge (see Settings).
            </TextBlock>
            <DataGrid ItemsSource="{Binding InputFiles}" SelectedItem="{Binding SelectedInputFile}" AutoGenerateColumns="False" MinHeight="120" MaxHeight="320"
                      CanUserSortColumns="False" IsReadOnly="False">
              <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Use" Binding="{Binding Included}" Width="50" />
                <DataGridTextColumn Header="File" Binding="{Binding FileName}" IsReadOnly="True" Width="240" />
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160" />
                <DataGridTextColumn Header="Class" Binding="{Binding Class}" Width="100" />
                <DataGridTemplateColumn Header="Type" Width="120">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:InputFileViewModel">
                      <ComboBox ItemsSource="{x:Static vm:InputFileViewModel.SampleTypes}" SelectedItem="{Binding SampleType, Mode=TwoWay}" HorizontalAlignment="Stretch" MinHeight="24" Padding="6,2" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Acquisition" Width="120">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:InputFileViewModel">
                      <ComboBox ItemsSource="{x:Static vm:InputFileViewModel.AcquisitionModes}" SelectedItem="{Binding Acquisition, Mode=TwoWay}" HorizontalAlignment="Stretch" MinHeight="24" Padding="6,2" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Order" Binding="{Binding AnalyticalOrder}" Width="70" />
                <DataGridTemplateColumn Header="Format" Width="*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:InputFileViewModel">
                      <TextBlock Text="{Binding Badge}" Classes="badge" IsVisible="{Binding HasBadge}" VerticalAlignment="Center" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="{Binding FileCountText}" Classes="muted" Margin="0,6,0,0" />
          </StackPanel>
        </Border>

        <!-- output & mode -->
        <Border Classes="card">
          <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Output folder" />
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding OutputFolder}" Classes="param" Watermark="Folder for .pai2/.dcl, exports and the project" />
            <Button Grid.Row="0" Grid.Column="2" Content="Browse…" Margin="6,0,0,0" Command="{Binding BrowseOutputCommand}" />
            <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Mode" Margin="0,8,8,0" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0" Spacing="12">
              <ComboBox ItemsSource="{x:Static vm:ProjectViewModel.Modes}" SelectedItem="{Binding Mode}" Classes="param" Width="140" />
              <TextBlock Classes="muted" VerticalAlignment="Center" Text="LC-MS: peak picking → MS/MS deconvolution → MSP annotation → alignment.  GC-MS: EI deconvolution with RI/RT." />
            </StackPanel>
          </Grid>
        </Border>

        <!-- parameters -->
        <Border Classes="card">
          <StackPanel DataContext="{Binding Parameters}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                <Button Content="Load method…" Command="{Binding $parent[UserControl].DataContext.LoadMethodCommand}" />
                <Button Content="Save method…" Command="{Binding $parent[UserControl].DataContext.SaveMethodCommand}" />
              </StackPanel>
              <TextBlock Classes="h1" Text="Method parameters" />
            </DockPanel>

            <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
              <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Classes="h2" Text="Data type" />
                <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                  <TextBlock Grid.Row="0" Classes="label" Text="Ion mode" /><ComboBox Grid.Row="0" Grid.Column="1" Classes="param" ItemsSource="{x:Static vm:MethodParametersViewModel.IonPolarities}" SelectedItem="{Binding IonMode}" />
                  <TextBlock Grid.Row="1" Classes="label" Text="MS1 data type" /><ComboBox Grid.Row="1" Grid.Column="1" Classes="param" ItemsSource="{x:Static vm:MethodParametersViewModel.DataTypes}" SelectedItem="{Binding Ms1DataType}" />
                  <TextBlock Grid.Row="2" Classes="label" Text="MS2 data type" /><ComboBox Grid.Row="2" Grid.Column="1" Classes="param" ItemsSource="{x:Static vm:MethodParametersViewModel.DataTypes}" SelectedItem="{Binding Ms2DataType}" />
                  <TextBlock Grid.Row="3" Classes="label" Text="Acquisition type (default)" /><ComboBox Grid.Row="3" Grid.Column="1" Classes="param" ItemsSource="{x:Static vm:MethodParametersViewModel.AcquisitionModes}" SelectedItem="{Binding AcquisitionType}" />
                  <TextBlock Grid.Row="4" Classes="label" Text="Target omics" /><ComboBox Grid.Row="4" Grid.Column="1" Classes="param" ItemsSource="{x:Static vm:MethodParametersViewModel.OmicsTargets}" SelectedItem="{Binding TargetOmics}" />
                </Grid>

                <TextBlock Classes="h2" Text="Data collection" />
                <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                  <TextBlock Grid.Row="0" Classes="label" Text="RT begin (min)" /><NumericUpDown Grid.Row="0" Grid.Column="1" Classes="param" Value="{Binding RetentionTimeBegin}" Minimum="0" Increment="0.5" />
                  <TextBlock Grid.Row="1" Classes="label" Text="RT end (min)" /><NumericUpDown Grid.Row="1" Grid.Column="1" Classes="param" Value="{Binding RetentionTimeEnd}" Minimum="0" Increment="0.5" />
                  <TextBlock Grid.Row="2" Classes="label" Text="MS1 mass range begin" /><NumericUpDown Grid.Row="2" Grid.Column="1" Classes="param" Value="{Binding Ms1MassRangeBegin}" Minimum="0" Increment="10" />
                  <TextBlock Grid.Row="3" Classes="label" Text="MS1 mass range end" /><NumericUpDown Grid.Row="3" Grid.Column="1" Classes="param" Value="{Binding Ms1MassRangeEnd}" Minimum="0" Increment="10" />
                  <TextBlock Grid.Row="4" Classes="label" Text="MS2 mass range begin" /><NumericUpDown Grid.Row="4" Grid.Column="1" Classes="param" Value="{Binding Ms2MassRangeBegin}" Minimum="0" Increment="10" />
                  <TextBlock Grid.Row="5" Classes="label" Text="MS2 mass range end" /><NumericUpDown Grid.Row="5" Grid.Column="1" Classes="param" Value="{Binding Ms2MassRangeEnd}" Minimum="0" Increment="10" />
                  <TextBlock Grid.Row="6" Classes="label" Text="MS1 centroid tolerance (Da)" /><NumericUpDown Grid.Row="6" Grid.Column="1" Classes="param" Value="{Binding Ms1CentroidTolerance}" Minimum="0" Increment="0.001" />
                  <TextBlock Grid.Row="7" Classes="label" Text="MS2 centroid tolerance (Da)" /><NumericUpDown Grid.Row="7" Grid.Column="1" Classes="param" Value="{Binding Ms2CentroidTolerance}" Minimum="0" Increment="0.005" />
                </Grid>

                <TextBlock Classes="h2" Text="Peak detection" />
                <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                  <TextBlock Grid.Row="0" Classes="label" Text="Smoothing method" /><ComboBox Grid.Row="0" Grid.Column="1" Classes="param" ItemsSource="{x:Static vm:MethodParametersViewModel.SmoothingKinds}" SelectedItem="{Binding SmoothingMethod}" />
                  <TextBlock Grid.Row="1" Classes="label" Text="Smoothing level" /><NumericUpDown Grid.Row="1" Grid.Column="1" Classes="param" Value="{Binding SmoothingLevel}" Minimum="0" Increment="1" FormatString="0" />
                  <TextBlock Grid.Row="2" Classes="label" Text="Minimum peak width (scans)" /><NumericUpDown Grid.Row="2" Grid.Column="1" Classes="param" Value="{Binding MinimumPeakWidth}" Minimum="1" Increment="1" FormatString="0" />
                  <TextBlock Grid.Row="3" Classes="label" Text="Minimum peak height" /><NumericUpDown Grid.Row="3" Grid.Column="1" Classes="param" Value="{Binding MinimumPeakHeight}" Minimum="0" Increment="500" FormatString="0" />
                  <TextBlock Grid.Row="4" Classes="label" Text="Mass slice width (Da)" /><NumericUpDown Grid.Row="4" Grid.Column="1" Classes="param" Value="{Binding MassSliceWidth}" Minimum="0" Increment="0.01" />
                  <TextBlock Grid.Row="5" Classes="label" Text="Max charge number" /><NumericUpDown Grid.Row="5" Grid.Column="1" Classes="param" Value="{Binding MaxChargeNumber}" Minimum="1" Increment="1" FormatString="0" />
                  <TextBlock Grid.Row="6" Classes="label" Text="Searched adduct ions" /><TextBox Grid.Row="6" Grid.Column="1" Classes="param" Text="{Binding SearchedAdductIons}" />
                  <TextBlock Grid.Row="7" Classes="label" Text="Sigma window value" /><NumericUpDown Grid.Row="7" Grid.Column="1" Classes="param" Value="{Binding SigmaWindowValue}" Minimum="0" Increment="0.1" />
                  <TextBlock Grid.Row="8" Classes="label" Text="MS/MS amplitude cutoff" /><NumericUpDown Grid.Row="8" Grid.Column="1" Classes="param" Value="{Binding AmplitudeCutoff}" Minimum="0" Increment="10" />
                  <TextBlock Grid.Row="9" Classes="label" Text="Keep isotope range (Da)" /><NumericUpDown Grid.Row="9" Grid.Column="1" Classes="param" Value="{Binding KeepIsotopeRange}" Minimum="0" Increment="0.1" />
                  <CheckBox Grid.Row="10" Grid.Column="1" Content="Exclude fragments after precursor" IsChecked="{Binding ExcludeAfterPrecursor}" />
                </Grid>
              </StackPanel>

              <StackPanel Grid.Column="1">
                <TextBlock Classes="h2" Text="MS/MS identification (MSP)" />
                <Grid ColumnDefinitions="210,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                  <TextBlock Grid.Row="0" Classes="label" Text="MSP library file" />
                  <TextBox Grid.Row="0" Grid.Column="1" Classes="param" Text="{Binding MspFilePath}" Watermark="Path to a .msp / .msp2 library" />
                  <Button Grid.Row="0" Grid.Column="2" Content="Browse…" Margin="6,0,0,0" Command="{Binding $parent[UserControl].DataContext.BrowseMspCommand}" />
                  <TextBlock Grid.Row="1" Classes="label" Text="Text library (optional)" />
                  <TextBox Grid.Row="1" Grid.Column="1" Classes="param" Text="{Binding TextDbFilePath}" Watermark="RT / m/z text library" Margin="0,4,0,0" />
                  <Button Grid.Row="1" Grid.Column="2" Content="Browse…" Margin="6,4,0,0" Command="{Binding $parent[UserControl].DataContext.BrowseTextDbCommand}" />
                  <TextBlock Grid.Row="2" Classes="label" Text="MS1 tolerance (Da)" /><NumericUpDown Grid.Row="2" Grid.Column="1" Classes="param" Value="{Binding Ms1ToleranceForAnnotation}" Minimum="0" Increment="0.001" />
                  <TextBlock Grid.Row="3" Classes="label" Text="MS2 tolerance (Da)" /><NumericUpDown Grid.Row="3" Grid.Column="1" Classes="param" Value="{Binding Ms2ToleranceForAnnotation}" Minimum="0" Increment="0.005" />
                  <TextBlock Grid.Row="4" Classes="label" Text="RT tolerance (min)" /><NumericUpDown Grid.Row="4" Grid.Column="1" Classes="param" Value="{Binding RtToleranceForAnnotation}" Minimum="0" Increment="0.1" />
                  <TextBlock Grid.Row="5" Classes="label" Text="Total score cutoff (%)" /><NumericUpDown Grid.Row="5" Grid.Column="1" Classes="param" Value="{Binding TotalScoreCutoff}" Minimum="0" Maximum="100" Increment="5" />
                  <TextBlock Grid.Row="6" Classes="label" Text="Weighted dot product cutoff" /><NumericUpDown Grid.Row="6" Grid.Column="1" Classes="param" Value="{Binding WeightedDotProductCutoff}" Minimum="0" Maximum="1" Increment="0.05" />
                  <TextBlock Grid.Row="7" Classes="label" Text="Simple dot product cutoff" /><NumericUpDown Grid.Row="7" Grid.Column="1" Classes="param" Value="{Binding SimpleDotProductCutoff}" Minimum="0" Maximum="1" Increment="0.05" />
                  <TextBlock Grid.Row="8" Classes="label" Text="Reverse dot product cutoff" /><NumericUpDown Grid.Row="8" Grid.Column="1" Classes="param" Value="{Binding ReverseDotProductCutoff}" Minimum="0" Maximum="1" Increment="0.05" />
                  <TextBlock Grid.Row="9" Classes="label" Text="Matched peaks % cutoff" /><NumericUpDown Grid.Row="9" Grid.Column="1" Classes="param" Value="{Binding MatchedPeaksPercentageCutoff}" Minimum="0" Maximum="1" Increment="0.05" />
                  <TextBlock Grid.Row="10" Classes="label" Text="Minimum spectrum match" /><NumericUpDown Grid.Row="10" Grid.Column="1" Classes="param" Value="{Binding MinimumSpectrumMatch}" Minimum="0" Increment="1" />
                  <CheckBox Grid.Row="11" Grid.Column="1" Content="Use RT for scoring" IsChecked="{Binding UseRetentionInformationForScoring}" />
                  <CheckBox Grid.Row="12" Grid.Column="1" Content="Use RT for filtering" IsChecked="{Binding UseRetentionInformationForFiltering}" />
                  <CheckBox Grid.Row="13" Grid.Column="1" Content="Only report top hit" IsChecked="{Binding OnlyReportTopHit}" />
                </Grid>

                <TextBlock Classes="h2" Text="Alignment" />
                <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                  <CheckBox Grid.Row="0" Grid.Column="1" Content="Run alignment after peak picking" IsChecked="{Binding TogetherWithAlignment}" />
                  <TextBlock Grid.Row="1" Classes="label" Text="Reference file ID" /><NumericUpDown Grid.Row="1" Grid.Column="1" Classes="param" Value="{Binding AlignmentReferenceFileId}" Minimum="0" Increment="1" FormatString="0" />
                  <TextBlock Grid.Row="2" Classes="label" Text="RT tolerance (min)" /><NumericUpDown Grid.Row="2" Grid.Column="1" Classes="param" Value="{Binding RtToleranceForAlignment}" Minimum="0" Increment="0.05" />
                  <TextBlock Grid.Row="3" Classes="label" Text="MS1 tolerance (Da)" /><NumericUpDown Grid.Row="3" Grid.Column="1" Classes="param" Value="{Binding Ms1ToleranceForAlignment}" Minimum="0" Increment="0.005" />
                  <TextBlock Grid.Row="4" Classes="label" Text="RT factor" /><NumericUpDown Grid.Row="4" Grid.Column="1" Classes="param" Value="{Binding RtFactorForAlignment}" Minimum="0" Maximum="1" Increment="0.1" />
                  <TextBlock Grid.Row="5" Classes="label" Text="MS1 factor" /><NumericUpDown Grid.Row="5" Grid.Column="1" Classes="param" Value="{Binding Ms1FactorForAlignment}" Minimum="0" Maximum="1" Increment="0.1" />
                  <TextBlock Grid.Row="6" Classes="label" Text="Peak count filter (%)" /><NumericUpDown Grid.Row="6" Grid.Column="1" Classes="param" Value="{Binding PeakCountFilter}" Minimum="0" Maximum="100" Increment="5" />
                  <TextBlock Grid.Row="7" Classes="label" Text="N% detected in one group" /><NumericUpDown Grid.Row="7" Grid.Column="1" Classes="param" Value="{Binding NPercentDetectedInOneGroup}" Minimum="0" Maximum="100" Increment="5" />
                  <CheckBox Grid.Row="8" Grid.Column="1" Content="Gap filling by compulsion" IsChecked="{Binding GapFillingByCompulsion}" />
                </Grid>

                <TextBlock Classes="h2" Text="Export &amp; process" />
                <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto">
                  <CheckBox Grid.Row="0" Grid.Column="1" Content="Export QA height matrix (.qa.tsv)" IsChecked="{Binding IsHeightMatrixExport}" />
                  <TextBlock Grid.Row="1" Classes="label" Text="Number of threads" /><NumericUpDown Grid.Row="1" Grid.Column="1" Classes="param" Value="{Binding NumberOfThreads}" Minimum="1" Increment="1" FormatString="0" />
                </Grid>

                <StackPanel IsVisible="{Binding IsGcms}">
                  <TextBlock Classes="h2" Text="GC-MS" />
                  <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Classes="label" Text="Retention type" /><ComboBox Grid.Row="0" Grid.Column="1" Classes="param" ItemsSource="{x:Static vm:MethodParametersViewModel.RetentionKinds}" SelectedItem="{Binding RetentionType}" />
                    <TextBlock Grid.Row="1" Classes="label" Text="RI compound type" /><ComboBox Grid.Row="1" Grid.Column="1" Classes="param" ItemsSource="{x:Static vm:MethodParametersViewModel.RiCompoundKinds}" SelectedItem="{Binding RiCompoundType}" />
                    <TextBlock Grid.Row="2" Classes="label" Text="Alignment index type" /><ComboBox Grid.Row="2" Grid.Column="1" Classes="param" ItemsSource="{x:Static vm:MethodParametersViewModel.RetentionKinds}" SelectedItem="{Binding AlignmentIndexType}" />
                    <TextBlock Grid.Row="3" Classes="label" Text="RI dictionary table" /><TextBox Grid.Row="3" Grid.Column="1" Classes="param" Text="{Binding RiIndexFilePaths}" Watermark="TSV: raw file path ⇥ RI dictionary path" />
                  </Grid>
                </StackPanel>
              </StackPanel>
            </Grid>

            <Expander Header="Advanced: edit method file text" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Classes="muted" Margin="0,4,0,4" Text="Console-compatible method file. Edits are applied to the form when the box loses focus; unknown keys are kept and passed through." />
                <TextBox Text="{Binding MethodText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" FontFamily="Menlo, Consolas, monospace" FontSize="12" MinHeight="260" MaxHeight="480" TextWrapping="NoWrap" />
                <TextBlock Text="{Binding TextError}" Foreground="#E15759" />
              </StackPanel>
            </Expander>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
