<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenDIAL.Desktop.ViewModels"
             xmlns:c="using:OpenDIAL.Desktop.Controls"
             x:Class="OpenDIAL.Desktop.Views.StatisticsView"
             x:DataType="vm:StatisticsViewModel">
  <!--
    The dataset seen whole: where the injections fall against each other, how they group, and which
    features fragment alike. One options band drives all three, because they are three readings of
    the same matrix.
  -->
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="band">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Classes="muted" Text="{Binding Summary}" VerticalAlignment="Center" Margin="12,0,4,0" MaxWidth="320" TextTrimming="CharacterEllipsis" />
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Classes="label" Text="Value" />
          <ComboBox Classes="compact" ItemsSource="{x:Static vm:StatisticsViewModel.ValueKinds}" SelectedItem="{Binding ValueKind}" Width="96" />
          <TextBlock Classes="label" Text="Transform" Margin="6,0,0,0" />
          <ComboBox Classes="compact" ItemsSource="{x:Static vm:StatisticsViewModel.Transforms}" SelectedItem="{Binding Transform}" Width="96" />
          <TextBlock Classes="label" Text="Scaling" Margin="6,0,0,0" />
          <ComboBox Classes="compact" ItemsSource="{x:Static vm:StatisticsViewModel.Scalings}" SelectedItem="{Binding Scaling}" Width="180"
                    ToolTip.Tip="Unit variance gives every feature the same weight; centre only lets the abundant ones lead" />
          <CheckBox Classes="compact" Content="Annotated only" IsChecked="{Binding AnnotatedOnly}" Margin="6,0,0,0" />
          <CheckBox Classes="compact" Content="Drift corrected" IsChecked="{Binding UseCorrectedValues}" IsVisible="{Binding HasCorrection}"
                    ToolTip.Tip="Feed every view on this page the values corrected against the quality controls, instead of the raw ones" />
          <Button Classes="tool strong" Content="Recompute" Command="{Binding ComputeCommand}" IsEnabled="{Binding HasResults}" />
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Width="70" Height="3" VerticalAlignment="Center" />
        </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Panel Margin="8">
      <TextBlock Classes="faint" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasResults}"
                 Text="Process a batch of two or more injections, or open a project, to see the dataset as a whole." />

      <TabControl x:Name="StatsTabs" Classes="panel-tabs" IsVisible="{Binding HasResults}">
        <!-- principal components -->
        <TabItem Header="Principal components">
          <Grid Margin="0,6,0,0" ColumnDefinitions="*,6,*" RowDefinitions="*">
            <Border Grid.Column="0" Classes="panel">
              <DockPanel Margin="6">
                <TextBlock DockPanel.Dock="Top" Classes="eyebrow" Text="SCORES · ONE POINT PER INJECTION" Margin="4,4,4,6" />
                <TextBlock DockPanel.Dock="Bottom" Classes="hint" Margin="4,6,4,0" TextWrapping="Wrap"
                           Text="Replicates of a class should sit together and the classes apart. An injection that lands among the wrong group, or far from everything, is the first to check." />
                <c:ScatterChart Items="{Binding Scores}" XLabel="PC1" YLabel="PC2" />
              </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" Classes="vertical" ResizeDirection="Columns" />
            <Border Grid.Column="2" Classes="panel">
              <DockPanel Margin="6">
                <TextBlock DockPanel.Dock="Top" Classes="eyebrow" Text="LOADINGS · ONE POINT PER FEATURE" Margin="4,4,4,6" />
                <Border DockPanel.Dock="Bottom" Padding="4,6,4,0">
                  <DockPanel>
                    <DataGrid DockPanel.Dock="Right" Width="230" ItemsSource="{Binding Variance}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="110">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Component" Binding="{Binding Component}" Width="*" />
                        <DataGridTextColumn Header="%" Binding="{Binding Percent, StringFormat={}{0:F1}}" Width="60" />
                        <DataGridTextColumn Header="Cum." Binding="{Binding Cumulative, StringFormat={}{0:F1}}" Width="60" />
                      </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Classes="hint" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"
                               Text="A feature far from the centre in the direction that separates the groups is what drives them apart. Coloured by lipid class." />
                  </DockPanel>
                </Border>
                <c:ScatterChart Items="{Binding Loadings}" XLabel="PC1 loading" YLabel="PC2 loading" />
              </DockPanel>
            </Border>
          </Grid>
        </TabItem>

        <!-- drift and batch correction -->
        <TabItem Header="Drift correction">
          <Border Classes="panel" Margin="0,6,0,0">
            <DockPanel Margin="6">
              <Border DockPanel.Dock="Top" Classes="hairline-bottom" Padding="4,2,4,8" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Classes="label" Text="Smoothing span" VerticalAlignment="Center" />
                  <TextBox Text="{Binding CorrectionSpan}" Width="62"
                           ToolTip.Tip="The share of the controls each local fit sees. Wide follows the slow fall; narrow follows every wobble, including noise." />
                  <Button Classes="tool strong" Content="Correct against the controls" Command="{Binding ApplyCorrectionCommand}" IsEnabled="{Binding !IsCorrecting}" />
                  <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsCorrecting}" Width="80" Height="3" VerticalAlignment="Center" />
                  <TextBlock Classes="hint" Text="{Binding CorrectionVerdict}" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Border>
              <TextBlock DockPanel.Dock="Bottom" Classes="hint" Margin="4,6,4,0" TextWrapping="Wrap" Text="{Binding CorrectionDetail}" />
              <Grid ColumnDefinitions="380,6,*">
                <DataGrid Grid.Column="0" ItemsSource="{Binding CorrectionRows}" SelectedItem="{Binding SelectedCorrectionRow}"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserSortColumns="True">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Feature" Binding="{Binding Label}" Width="*" />
                    <DataGridTextColumn Header="CV before" Binding="{Binding CvBefore, StringFormat={}{0:F1} %}" Width="90" />
                    <DataGridTextColumn Header="CV after" Binding="{Binding CvAfter, StringFormat={}{0:F1} %}" Width="90" />
                  </DataGrid.Columns>
                </DataGrid>
                <GridSplitter Grid.Column="1" Classes="vertical" ResizeDirection="Columns" />
                <Grid Grid.Column="2" RowDefinitions="*,6,*">
                  <Border Grid.Row="0" Classes="panel">
                    <DockPanel Margin="6">
                      <TextBlock DockPanel.Dock="Top" Classes="eyebrow" Text="BEFORE · RESPONSE ACROSS THE RUN" Margin="4,4,4,6" />
                      <c:ScatterChart Items="{Binding DriftBefore}" Connect="True" XLabel="Injection order" YLabel="Response" />
                    </DockPanel>
                  </Border>
                  <GridSplitter Grid.Row="1" Classes="horizontal" ResizeDirection="Rows" />
                  <Border Grid.Row="2" Classes="panel">
                    <DockPanel Margin="6">
                      <TextBlock DockPanel.Dock="Top" Classes="eyebrow" Text="AFTER" Margin="4,4,4,6" />
                      <TextBlock DockPanel.Dock="Bottom" Classes="hint" Margin="4,6,4,0" TextWrapping="Wrap"
                                 Text="The controls are the same material every time, so whatever they do across the sequence is the instrument. A control trace that falls away or steps at a batch boundary is drift; after correcting it should be flat, and the samples should have moved with it." />
                      <c:ScatterChart Items="{Binding DriftAfter}" Connect="True" XLabel="Injection order" YLabel="Corrected response" />
                    </DockPanel>
                  </Border>
                </Grid>
              </Grid>
            </DockPanel>
          </Border>
        </TabItem>

        <!-- supervised discriminant model -->
        <TabItem Header="Discriminant">
          <Border Classes="panel" Margin="0,6,0,0">
            <DockPanel Margin="6">
              <Border DockPanel.Dock="Top" Classes="hairline-bottom" Padding="4,2,4,8" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Classes="label" Text="Components" VerticalAlignment="Center" />
                  <TextBox Text="{Binding PlsComponents}" Width="52" />
                  <TextBlock Classes="label" Text="Permutations" VerticalAlignment="Center" Margin="6,0,0,0" />
                  <TextBox Text="{Binding PlsPermutations}" Width="62"
                           ToolTip.Tip="How many times the labels are shuffled to see how well chance does. Zero skips the test." />
                  <Button Classes="tool strong" Content="Fit against the classes" Command="{Binding FitDiscriminantCommand}" IsEnabled="{Binding !IsFittingPls}" />
                  <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsFittingPls}" Width="80" Height="3" VerticalAlignment="Center" />
                  <TextBlock Classes="hint" Text="{Binding PlsQuality}" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Border>
              <Border DockPanel.Dock="Bottom" Padding="4,8,4,0">
                <TextBlock Classes="hint" TextWrapping="Wrap" Text="{Binding PlsVerdict}" />
              </Border>
              <Grid ColumnDefinitions="*,6,*">
                <Border Grid.Column="0" Classes="panel">
                  <DockPanel Margin="6">
                    <TextBlock DockPanel.Dock="Top" Classes="eyebrow" Text="SCORES · ONE POINT PER INJECTION" Margin="4,4,4,6" />
                    <TextBlock DockPanel.Dock="Bottom" Classes="hint" Margin="4,6,4,0" Text="{Binding PlsScoreLabel}" />
                    <c:ScatterChart Items="{Binding PlsScores}" XLabel="Component 1" YLabel="Component 2" />
                  </DockPanel>
                </Border>
                <GridSplitter Grid.Column="1" Classes="vertical" ResizeDirection="Columns" />
                <Border Grid.Column="2" Classes="panel">
                  <DockPanel Margin="6">
                    <TextBlock DockPanel.Dock="Top" Classes="eyebrow" Text="FEATURES BY VIP · CLICK ONE TO OPEN IT" Margin="4,4,4,6" />
                    <TextBlock DockPanel.Dock="Bottom" Classes="hint" Margin="4,6,4,0" TextWrapping="Wrap"
                               Text="VIP above one is the usual mark of a feature the separation rests on, and the side says which class it goes with. None of it means anything if the model did not survive cross-validation." />
                    <DataGrid ItemsSource="{Binding VipRows}" SelectedItem="{Binding SelectedVipRow}"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserSortColumns="True">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Feature" Binding="{Binding Label}" Width="*" />
                        <DataGridTextColumn Header="Class" Binding="{Binding Group}" Width="90" />
                        <DataGridTextColumn Header="Higher in" Binding="{Binding Side}" Width="110" />
                        <DataGridTextColumn Header="VIP" Binding="{Binding Vip, StringFormat={}{0:F2}}" Width="70" />
                      </DataGrid.Columns>
                    </DataGrid>
                  </DockPanel>
                </Border>
              </Grid>
            </DockPanel>
          </Border>
        </TabItem>

        <!-- the orthogonal rotation of the same question -->
        <TabItem Header="Orthogonal">
          <Border Classes="panel" Margin="0,6,0,0">
            <DockPanel Margin="6">
              <Border DockPanel.Dock="Top" Classes="hairline-bottom" Padding="4,2,4,8" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Classes="label" Text="Orthogonal components" VerticalAlignment="Center" />
                  <TextBox Text="{Binding OrthogonalComponents}" Width="52"
                           ToolTip.Tip="How many rounds of variation unrelated to the classes to strip out before the predictive one is taken" />
                  <TextBlock Classes="label" Text="Permutations" VerticalAlignment="Center" Margin="6,0,0,0" />
                  <TextBox Text="{Binding OplsPermutations}" Width="62" />
                  <Button Classes="tool strong" Content="Fit the orthogonal model" Command="{Binding FitOrthogonalCommand}" IsEnabled="{Binding !IsFittingOpls}" />
                  <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsFittingOpls}" Width="80" Height="3" VerticalAlignment="Center" />
                  <TextBlock Classes="hint" Text="{Binding OplsQuality}" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Border>
              <Border DockPanel.Dock="Bottom" Padding="4,8,4,0">
                <TextBlock Classes="hint" TextWrapping="Wrap" Text="{Binding OplsVerdict}" />
              </Border>
              <Grid ColumnDefinitions="*,6,*">
                <Border Grid.Column="0" Classes="panel">
                  <DockPanel Margin="6">
                    <TextBlock DockPanel.Dock="Top" Classes="eyebrow" Text="SCORES · THE SEPARATION ON ONE AXIS" Margin="4,4,4,6" />
                    <TextBlock DockPanel.Dock="Bottom" Classes="hint" Margin="4,6,4,0" TextWrapping="Wrap" Text="{Binding OplsScoreLabel}" />
                    <c:ScatterChart Items="{Binding OplsScores}" XLabel="Predictive" YLabel="Orthogonal" />
                  </DockPanel>
                </Border>
                <GridSplitter Grid.Column="1" Classes="vertical" ResizeDirection="Columns" />
                <Grid Grid.Column="2" RowDefinitions="*,6,220">
                  <Border Grid.Row="0" Classes="panel">
                    <DockPanel Margin="6">
                      <TextBlock DockPanel.Dock="Top" Classes="eyebrow" Text="S-PLOT · MAGNITUDE ACROSS, RELIABILITY UP" Margin="4,4,4,6" />
                      <TextBlock DockPanel.Dock="Bottom" Classes="hint" Margin="4,6,4,0" TextWrapping="Wrap"
                                 Text="Across is how much of the separation a feature carries; up is how consistently it carries it. Only the two far corners are worth acting on: a feature high up but near the middle is reliable and tiny, and one far out but low down is one loud injection. Click a point to open it." />
                      <c:ScatterChart Items="{Binding SPlot}" SelectedItem="{Binding SelectedSPlotPoint, Mode=TwoWay}" XLabel="Covariance with the predictive component" YLabel="Correlation" />
                    </DockPanel>
                  </Border>
                  <GridSplitter Grid.Row="1" Classes="horizontal" ResizeDirection="Rows" />
                  <Border Grid.Row="2" Classes="panel">
                    <DockPanel Margin="6">
                      <TextBlock DockPanel.Dock="Top" Classes="eyebrow" Text="THE CORNERS, IN ORDER" Margin="4,4,4,6" />
                      <DataGrid ItemsSource="{Binding SPlotRows}" SelectedItem="{Binding SelectedSPlotRow}"
                                AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserSortColumns="True">
                        <DataGrid.Columns>
                          <DataGridTextColumn Header="Feature" Binding="{Binding Label}" Width="*" />
                          <DataGridTextColumn Header="Higher in" Binding="{Binding Side}" Width="110" />
                          <DataGridTextColumn Header="Covariance" Binding="{Binding Covariance, StringFormat={}{0:F2}}" Width="96" />
                          <DataGridTextColumn Header="r" Binding="{Binding Correlation, StringFormat={}{0:F2}}" Width="60" />
                          <DataGridTextColumn Header="VIP" Binding="{Binding Vip, StringFormat={}{0:F2}}" Width="60" />
                        </DataGrid.Columns>
                      </DataGrid>
                    </DockPanel>
                  </Border>
                </Grid>
              </Grid>
            </DockPanel>
          </Border>
        </TabItem>

        <!-- hierarchical clustering -->
        <TabItem Header="Clustering">
          <Border Classes="panel" Margin="0,6,0,0">
            <DockPanel Margin="10">
              <TextBlock DockPanel.Dock="Top" Classes="hint" Text="{Binding ClusterLabel}" Margin="0,0,0,8" />
              <TextBlock DockPanel.Dock="Bottom" Classes="hint" Margin="0,8,0,0" TextWrapping="Wrap"
                         Text="Injections join at the height where their profiles stop agreeing. Replicates of a class should join low and the blanks should hang off on their own; one that joins the wrong group is a mix-up or a bad run." />
              <c:Dendrogram Root="{Binding ClusterRoot}" />
            </DockPanel>
          </Border>
        </TabItem>

        <!-- molecular network -->
        <TabItem Header="Molecular network">
          <Border Classes="panel" Margin="0,6,0,0">
            <DockPanel Margin="6">
              <Border DockPanel.Dock="Top" Classes="hairline-bottom" Padding="4,2,4,8" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Classes="label" Text="Similarity ≥" VerticalAlignment="Center" />
                  <TextBox Text="{Binding NetworkCutoff}" Width="62" />
                  <TextBlock Classes="label" Text="fragment tol." VerticalAlignment="Center" Margin="6,0,0,0" />
                  <TextBox Text="{Binding NetworkTolerance}" Width="62" />
                  <CheckBox Classes="compact" Content="Show unlinked" IsChecked="{Binding ShowUnconnected}" ToolTip.Tip="Also draw the features joined to nothing; off by default because they crowd out the clusters" />
                  <Button Classes="tool strong" Content="Build network" Command="{Binding BuildNetworkCommand}" IsEnabled="{Binding !IsBuildingNetwork}" />
                  <Button Classes="tool" Content="Export for Cytoscape…" Command="{Binding ExportNetworkCommand}" />
                  <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBuildingNetwork}" Width="80" Height="3" VerticalAlignment="Center" />
                  <TextBlock Classes="hint" Text="{Binding NetworkLabel}" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Border>
              <TextBlock DockPanel.Dock="Bottom" Classes="hint" Margin="4,6,4,0" TextWrapping="Wrap"
                         Text="Features whose product spectra look alike are joined. One lipid class fragments the same way and forms a cluster, so a feature named as one class sitting inside another's cluster is worth a second look, and an unknown next to a named cluster is a candidate for the same family. Click a node to open it in the ion table." />
              <c:NetworkGraph Network="{Binding NetworkResult}" SelectedFeatureId="{Binding SelectedNetworkFeature, Mode=TwoWay}" />
            </DockPanel>
          </Border>
        </TabItem>
      </TabControl>
    </Panel>
  </DockPanel>
</UserControl>
