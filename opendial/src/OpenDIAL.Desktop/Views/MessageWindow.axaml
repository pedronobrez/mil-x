<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpenDIAL.Desktop.Views.MessageWindow"
        Width="460" SizeToContent="Height" CanResize="False"
        FontSize="13" Background="{DynamicResource OdCanvas}"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24" Spacing="14">
    <TextBlock x:Name="TitleText" Classes="title" />
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" Classes="muted" />
    <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0" />
  </StackPanel>
</Window>
