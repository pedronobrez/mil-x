<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenDIAL.Desktop.ViewModels"
             xmlns:c="using:OpenDIAL.Desktop.Controls"
             xmlns:model="using:OpenDIAL.Pipeline.Model"
             x:Class="OpenDIAL.Desktop.Views.ResultsView"
             x:DataType="vm:ResultsViewModel">
  <DockPanel Margin="14,10">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <Button DockPanel.Dock="Right" Content="Open output folder" Command="{Binding OpenOutputFolderCommand}" IsEnabled="{Binding HasSession}" />
      <StackPanel>
        <TextBlock Classes="h1" Text="{Binding SessionTitle}" />
        <TextBlock Classes="muted" Text="{Binding StatusText}" />
      </StackPanel>
    </DockPanel>

    <TabControl x:Name="ResultsTabs">
      <!-- ============ peaks ============ -->
      <TabItem Header="Peaks">
        <Grid RowDefinitions="Auto,*" ColumnDefinitions="5*,6*">
          <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="12" Margin="0,6,0,6">
            <TextBlock Classes="label" Text="File" />
            <ComboBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" MinWidth="280" />
            <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding PeakSummary}" />
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Width="120" Height="6" VerticalAlignment="Center" />
          </StackPanel>
          <DataGrid Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Peaks}" SelectedItem="{Binding SelectedPeak}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,8,0">
            <DataGrid.Columns>
              <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" />
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="170" />
              <DataGridTextColumn Header="RT" Binding="{Binding Rt, StringFormat={}{0:F3}}" Width="65" />
              <DataGridTextColumn Header="m/z" Binding="{Binding Mz, StringFormat={}{0:F4}}" Width="90" />
              <DataGridTextColumn Header="Height" Binding="{Binding Height, StringFormat={}{0:N0}}" Width="90" />
              <DataGridTextColumn Header="Area" Binding="{Binding Area, StringFormat={}{0:N0}}" Width="90" />
              <DataGridTextColumn Header="Adduct" Binding="{Binding Adduct}" Width="80" />
              <DataGridTextColumn Header="Isotope" Binding="{Binding Isotope}" Width="60" />
              <DataGridTextColumn Header="Score" Binding="{Binding Score, StringFormat={}{0:F3}}" Width="65" />
              <DataGridTextColumn Header="S/N" Binding="{Binding SignalToNoise, StringFormat={}{0:F1}}" Width="70" />
              <DataGridCheckBoxColumn Header="MS2" Binding="{Binding HasMs2}" Width="50" />
            </DataGrid.Columns>
          </DataGrid>
          <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="*,*">
            <Border Grid.Row="0" Classes="card" Padding="4" Margin="0,0,0,6">
              <c:LineChart Points="{Binding EicPoints}" HighlightStart="{Binding EicHighlightStart}" HighlightEnd="{Binding EicHighlightEnd}" MarkerX="{Binding EicMarker}" Title="{Binding EicTitle}" />
            </Border>
            <Border Grid.Row="1" Classes="card" Padding="4" Margin="0">
              <c:SpectrumChart Peaks="{Binding Ms2Peaks}" ReferencePeaks="{Binding ReferencePeaks}" PrecursorMz="{Binding Ms2Precursor}" Title="{Binding Ms2Title}" />
            </Border>
          </Grid>
        </Grid>
      </TabItem>

      <!-- ============ alignment ============ -->
      <TabItem Header="Alignment">
        <Grid RowDefinitions="Auto,*" ColumnDefinitions="5*,6*">
          <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Classes="muted" Text="{Binding AlignmentSummary}" Margin="0,6,0,6" />
          <DataGrid Grid.Row="1" Grid.Column="0" ItemsSource="{Binding AlignmentSpots}" SelectedItem="{Binding SelectedSpot}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,8,0">
            <DataGrid.Columns>
              <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" />
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="170" />
              <DataGridTextColumn Header="RT" Binding="{Binding Rt, StringFormat={}{0:F3}}" Width="65" />
              <DataGridTextColumn Header="m/z" Binding="{Binding Mz, StringFormat={}{0:F4}}" Width="90" />
              <DataGridTextColumn Header="Avg height" Binding="{Binding AverageHeight, StringFormat={}{0:N0}}" Width="95" />
              <DataGridTextColumn Header="Fill %" Binding="{Binding FillPercent, StringFormat={}{0:F0}}" Width="60" />
              <DataGridTextColumn Header="Adduct" Binding="{Binding Adduct}" Width="80" />
              <DataGridTextColumn Header="Score" Binding="{Binding Score, StringFormat={}{0:F3}}" Width="65" />
            </DataGrid.Columns>
          </DataGrid>
          <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="*,*">
            <Border Grid.Row="0" Classes="card" Padding="4" Margin="0,0,0,6">
              <c:BarChart Items="{Binding BarItems}" Title="{Binding BarTitle}" />
            </Border>
            <Border Grid.Row="1" Classes="card" Padding="4" Margin="0">
              <c:SpectrumChart Peaks="{Binding AlignmentMs2Peaks}" Title="{Binding AlignmentMs2Title}" />
            </Border>
          </Grid>
        </Grid>
      </TabItem>

      <!-- ============ exports ============ -->
      <TabItem Header="Exports">
        <ScrollViewer>
          <StackPanel Margin="0,8">
            <TextBlock Classes="muted" Text="{Binding OutputFolder}" Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding Exports}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="model:ExportedFile">
                  <Border Classes="card" Padding="8" Margin="0,0,0,6">
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                        <Button Content="Open" Command="{Binding $parent[UserControl].DataContext.OpenExportCommand}" CommandParameter="{Binding}" />
                        <Button Content="Reveal" Command="{Binding $parent[UserControl].DataContext.RevealExportCommand}" CommandParameter="{Binding}" />
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Path}" Classes="muted" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
