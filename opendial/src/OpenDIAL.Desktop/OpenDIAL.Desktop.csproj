<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>OpenDIAL.Desktop</RootNamespace>
    <AssemblyName>OpenDIAL</AssemblyName>
    <ApplicationIcon />
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <Configurations>Debug;Release;Debug vendor unsupported;Release vendor unsupported</Configurations>
    <NoWarn>$(NoWarn);CS0618</NoWarn>
    <!-- output folder of the native SCIEX .wiff plugin; its files are mirrored into <app>/plugins/sciex after the build -->
    <SciexPluginDir>$(MSBuildThisFileDirectory)../OpenDIAL.Plugins.SciexWiff/bin/$(Configuration)/net8.0/</SciexPluginDir>
  </PropertyGroup>

  <PropertyGroup Condition="$(Configuration.StartsWith('Debug'))">
    <DefineConstants>$(DefineConstants);DEBUG</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Theme.axaml/AppStyles.axaml are picked up by Avalonia's default glob; the icon is not. -->
    <AvaloniaResource Include="Assets/icon.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenDIAL.Desktop.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.13" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.13" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.13" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.13" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.13" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.13" Condition="$(Configuration.StartsWith('Debug'))" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenDIAL.Pipeline\OpenDIAL.Pipeline.csproj" />
    <ProjectReference Include="..\OpenDIAL.Interop.OpenQuant\OpenDIAL.Interop.OpenQuant.csproj" />
    <!-- build the plugin first; it is consumed through OpenDIAL.Pipeline and mirrored into plugins/sciex below -->
    <ProjectReference Include="..\OpenDIAL.Plugins.SciexWiff\OpenDIAL.Plugins.SciexWiff.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!--
    Mirror the SCIEX plugin (reader + Clearcore2 SDK + licence text) into <app>/plugins/sciex, where
    OpenDIAL.RawData discovers raw-file readers. Assemblies the app already ships are excluded so the
    plugin folder never shadows the app's own copies.
  -->
  <Target Name="CopySciexPlugin" AfterTargets="Build" Condition="Exists('$(SciexPluginDir)')">
    <ItemGroup>
      <SciexPluginFile Include="$(SciexPluginDir)*.dll;$(SciexPluginDir)*.txt"
                       Exclude="$(SciexPluginDir)Common.dll;$(SciexPluginDir)OpenDIAL.RawData.dll;$(SciexPluginDir)NCDK.dll;$(SciexPluginDir)MessagePack*.dll;$(SciexPluginDir)Accord*.dll;$(SciexPluginDir)Newtonsoft.Json.dll;$(SciexPluginDir)Splash.dll;$(SciexPluginDir)MathNet.Numerics.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(SciexPluginFile)" DestinationFolder="$(OutDir)plugins/sciex/" SkipUnchangedFiles="true" ContinueOnError="true" />
  </Target>

</Project>
