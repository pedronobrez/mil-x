<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OpenDIAL.Desktop.Controls.ChartFrame">
  <!--
    A chart with the two things every figure needs before it leaves the application: a way to
    adjust how it looks, and a way to save it as a picture. The frame holds any chart control,
    finds it, and offers an options flyout and an export menu that work on whatever it found.
  -->
  <UserControl.Content>
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="4,4,4,6">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
          <Button x:Name="OptionsButton" Classes="icon" Content="⚙" ToolTip.Tip="Chart options: title, labels, sizes, palette">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel x:Name="Options" Spacing="6" Width="300">
                  <TextBlock Classes="eyebrow" Text="CHART OPTIONS" Margin="0" />
                  <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Classes="label" Text="Title" />
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="TitleBox" Margin="0,2" />
                    <TextBlock Grid.Row="1" Classes="label" Text="X label" />
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="XLabelBox" Margin="0,2" />
                    <TextBlock Grid.Row="2" Classes="label" Text="Y label" />
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="YLabelBox" Margin="0,2" />
                    <TextBlock Grid.Row="3" Classes="label" Text="Point size" />
                    <Slider Grid.Row="3" Grid.Column="1" x:Name="PointSizeSlider" Minimum="1.5" Maximum="12" Value="4.2" Margin="0,2" />
                    <TextBlock Grid.Row="4" Classes="label" Text="Font scale" />
                    <Slider Grid.Row="4" Grid.Column="1" x:Name="FontScaleSlider" Minimum="0.7" Maximum="2.2" Value="1" Margin="0,2" />
                    <TextBlock Grid.Row="5" Classes="label" Text="Palette" />
                    <ComboBox Grid.Row="5" Grid.Column="1" x:Name="PaletteBox" Classes="compact" Margin="0,2" HorizontalAlignment="Stretch">
                      <ComboBoxItem Content="Tableau" />
                      <ComboBoxItem Content="Okabe-Ito" />
                      <ComboBoxItem Content="Grey" />
                      <ComboBoxItem Content="Accent" />
                    </ComboBox>
                    <TextBlock Grid.Row="6" Classes="label" Text="Colour scale" />
                    <ComboBox Grid.Row="6" Grid.Column="1" x:Name="ColorScaleBox" Classes="compact" Margin="0,2" HorizontalAlignment="Stretch">
                      <ComboBoxItem Content="Blue–white–red" />
                      <ComboBoxItem Content="Viridis" />
                      <ComboBoxItem Content="Greys" />
                      <ComboBoxItem Content="Green–black–red" />
                    </ComboBox>
                    <CheckBox Grid.Row="7" Grid.Column="1" x:Name="GridBox" Classes="compact" Content="Grid" IsChecked="True" />
                    <CheckBox Grid.Row="8" Grid.Column="1" x:Name="LegendBox" Classes="compact" Content="Legend" IsChecked="True" />
                    <CheckBox Grid.Row="9" Grid.Column="1" x:Name="LabelsBox" Classes="compact" Content="Point labels" />
                  </Grid>
                  <CheckBox x:Name="EllipsesBox" Classes="compact" Content="95 % confidence ellipses" />
                  <CheckBox x:Name="TreesBox" Classes="compact" Content="Clustering trees" IsChecked="True" />
                  <CheckBox x:Name="ValuesBox" Classes="compact" Content="Values in the cells" />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button x:Name="ExportButton" Classes="tool" Content="Export…" Click="OnExport"
                  ToolTip.Tip="Save the chart as a picture: SVG or PNG, in the theme the figure wants rather than the window's" />
        </StackPanel>
        <TextBlock x:Name="Heading" Classes="eyebrow" Margin="4,0,0,0" VerticalAlignment="Center" />
      </DockPanel>
    </Border>
    <ContentPresenter x:Name="Host" />
  </DockPanel>
  </UserControl.Content>
</UserControl>
