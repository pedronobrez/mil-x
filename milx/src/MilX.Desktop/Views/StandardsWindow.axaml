<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:MilX.Desktop.Views"
        x:Class="MilX.Desktop.Views.StandardsWindow"
        Title="Internal standards" Width="820" Height="560" MinWidth="640" MinHeight="400"
        FontSize="13" Background="{DynamicResource OdCanvas}"
        WindowStartupLocation="CenterOwner">
  <!--
    One row per lipid class that has at least one confirmed analyte, and for each the confirmed
    feature to divide by. The suggestion is a deuterated standard of the class, then an odd-chain
    species of it; anything else — a standard of another class, no standard at all — is a decision
    for the person, and it is listed.
  -->
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,12">
      <TextBlock Classes="title" Text="Internal standard for each class" />
      <TextBlock Classes="muted" TextWrapping="Wrap"
                 Text="Each confirmed analyte is divided by the standard of its class, injection by injection. A class left at none keeps its raw peak areas. Only confirmed features are offered; confirm a standard in the review workspace if it is missing here." />
    </StackPanel>
    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
        <Button Content="Cancel" Click="OnCancel" MinWidth="90" />
        <Button x:Name="UseButton" Classes="primary" Content="Use these standards" Click="OnUse" MinWidth="150" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Suggest again" Click="OnSuggest" ToolTip.Tip="Put the suggested standard back in every class" />
        <Button Content="Clear all" Click="OnClear" ToolTip.Tip="Set every class to none" />
        <TextBlock x:Name="Summary" Classes="muted" VerticalAlignment="Center" Margin="8,0,0,0" />
      </StackPanel>
    </DockPanel>
    <Border Classes="card" Padding="12">
      <ScrollViewer>
        <ItemsControl x:Name="Rows">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="views:StandardRow">
              <Grid ColumnDefinitions="150,100,*" Margin="0,3">
                <TextBlock Grid.Column="0" Classes="strong" Text="{Binding Class}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Confirmed, StringFormat='{}{0} confirmed'}" VerticalAlignment="Center" />
                <ComboBox Grid.Column="2" Classes="compact" ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="6,0,0,0" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
  </DockPanel>
</Window>
