<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MilX.Desktop.ViewModels"
             xmlns:c="using:MilX.Desktop.Controls"
             xmlns:views="using:MilX.Desktop.Views"
             xmlns:res="using:MilX.Pipeline.Results"
             x:Class="MilX.Desktop.Views.ExplorerView"
             x:DataType="vm:ExplorerViewModel">
  <DockPanel>
    <!-- toolbar: a band of type -->
    <Border DockPanel.Dock="Top" Classes="band">
      <StackPanel Orientation="Horizontal" Spacing="2">
        <ToggleButton Classes="tool" Content="Select range" IsChecked="{Binding RangeSelectionMode}" ToolTip.Tip="Drag selects a retention-time range (Shift+drag always does)" />
        <Button Classes="tool" Content="Overview" Click="OnOverview" ToolTip.Tip="Fit the whole chromatogram (double-click does the same)" />
        <Button Classes="tool" Content="Clear range" Command="{Binding ClearSelectionCommand}" IsEnabled="{Binding HasSelection}" />
        <Rectangle Classes="vsep" />
        <ToggleButton Classes="tool" Content="Normalise" IsChecked="{Binding Normalize}" />
        <ToggleButton Classes="tool" Content="Stack" IsChecked="{Binding Stack}" />
        <ToggleButton Classes="tool" Content="Contour" IsChecked="{Binding ShowContour}" ToolTip.Tip="The active channel as retention time × m/z × intensity (View ▸ Explorer: contour view)" />
        <Rectangle Classes="vsep" />
        <ToggleButton Classes="tool" Content="m/z labels" IsChecked="{Binding ShowMzLabels}" />
        <ToggleButton Classes="tool" Content="RT labels" IsChecked="{Binding ShowRtLabels}" />
        <ToggleButton Classes="tool" Content="Legend" IsChecked="{Binding ShowLegend}" />
        <Rectangle Classes="vsep" />
        <TextBlock Classes="label" Text="Smooth (σ, scans)" Margin="6,0,6,0" />
        <NumericUpDown Classes="small" Value="{Binding SmoothSigma}" Minimum="0" Maximum="50" Increment="0.5" Width="112" />
        <TextBlock Classes="label" Text="Baseline (min)" Margin="10,0,6,0" />
        <NumericUpDown Classes="small" Value="{Binding BaselineWindow}" Minimum="0" Maximum="60" Increment="0.5" Width="112" />
      </StackPanel>
    </Border>

    <Grid ColumnDefinitions="370,6,*,6,420" Margin="8,8,8,8">
      <!-- left: samples and channels -->
      <Border Grid.Column="0" Classes="panel">
        <DockPanel>
          <Border DockPanel.Dock="Top" Padding="12,10,12,6">
            <StackPanel Spacing="8">
              <TextBlock Classes="eyebrow" Text="SAMPLES AND CHANNELS" Margin="0" />
              <TextBox Text="{Binding FilterText}" Watermark="Filter channels (e.g. MS2 313.2)" />
            </StackPanel>
          </Border>
          <Border DockPanel.Dock="Bottom" Classes="hairline-top" Padding="8,6">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Button Classes="tool" Content="Uncheck all" Command="{Binding UncheckAllCommand}" />
              <Button Classes="tool" Content="TIC of all" Command="{Binding CheckAllTicCommand}" />
              <Button Classes="tool" Content="Collapse" Command="{Binding CollapseAllCommand}" />
            </StackPanel>
          </Border>
          <TreeView ItemsSource="{Binding Tree}" SelectedItem="{Binding SelectedNode, Mode=TwoWay}" BorderThickness="0" CornerRadius="0" Background="Transparent" Margin="4,0">
            <TreeView.Styles>
              <Style Selector="TreeViewItem" x:DataType="vm:ExplorerNode">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                <Setter Property="IsVisible" Value="{Binding IsVisible}" />
              </Style>
            </TreeView.Styles>
            <TreeView.ItemTemplate>
              <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="vm:ExplorerNode">
                <StackPanel Orientation="Horizontal" Spacing="6" MinHeight="22">
                  <CheckBox Classes="compact" IsChecked="{Binding IsChecked, Mode=TwoWay}" IsVisible="{Binding IsLeaf}" Content="{Binding Label}" />
                  <TextBlock Text="{Binding Label}" IsVisible="{Binding !IsLeaf}" VerticalAlignment="Center" FontWeight="{Binding IsLeaf, Converter={x:Static views:ExplorerView.WeightForNode}}" />
                  <TextBlock Classes="hint" Text="{Binding Detail}" VerticalAlignment="Center" />
                </StackPanel>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </DockPanel>
      </Border>
      <GridSplitter Grid.Column="1" Classes="vertical" ResizeDirection="Columns" />

      <!-- centre: chromatogram over spectrum -->
      <Grid Grid.Column="2" RowDefinitions="Auto,*,6,Auto,*">
        <Border Grid.Row="0" Padding="2,0,2,6">
          <DockPanel>
            <TextBlock Classes="label" Text="Chromatogram" />
            <ComboBox Classes="compact" ItemsSource="{x:Static vm:ExplorerViewModel.ChromatogramKinds}" SelectedItem="{Binding ChromatogramKind}" Width="80" />
            <TextBlock Classes="label" Text="Active channel (spectra / XIC)" Margin="16,0,10,0" />
            <ComboBox Classes="compact" ItemsSource="{Binding ActiveChannels}" SelectedItem="{Binding ActiveChannel}" HorizontalAlignment="Stretch" />
          </DockPanel>
        </Border>
        <Border Grid.Row="1" Classes="panel">
          <Grid>
            <c:LineChart x:Name="Chromatogram" Series="{Binding Series}" Title="{Binding ChromatogramTitle}" MarkerX="{Binding MarkerRt}" Windows="{Binding Windows}"
                         Stack="{Binding Stack}" ShowLegend="{Binding ShowLegend}" ShowRtLabels="{Binding ShowRtLabels}" RangeSelectionMode="{Binding RangeSelectionMode}"
                         SelectionStart="{Binding SelectionStart, Mode=TwoWay}" SelectionEnd="{Binding SelectionEnd, Mode=TwoWay}" AutoZoomToHighlight="False"
                         YLabel="{Binding Normalize, Converter={x:Static views:ExplorerView.YLabelFor}}" IsVisible="{Binding !ShowContour}" />
            <DockPanel IsVisible="{Binding ShowContour}">
              <Border DockPanel.Dock="Top" Classes="hairline-bottom" Padding="8,4">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="label" Text="Intensity" />
                  <ComboBox Classes="compact" ItemsSource="{x:Static vm:ExplorerViewModel.ContourIntensityScales}" SelectedItem="{Binding ContourScale}" Width="86" />
                  <TextBlock Classes="label" Text="Colours" Margin="8,0,0,0" />
                  <ComboBox Classes="compact" ItemsSource="{x:Static vm:ExplorerViewModel.ContourColourMaps}" SelectedItem="{Binding ContourColours}" Width="96" />
                  <TextBlock Classes="label" Text="m/z" Margin="8,0,0,0" />
                  <NumericUpDown Classes="small" Value="{Binding ContourMzFrom}" Minimum="0" Increment="10" FormatString="0.##" Width="108" ToolTip.Tip="Lower m/z of the surface; 0 for the channel's own range" />
                  <TextBlock Classes="label" Text="to" />
                  <NumericUpDown Classes="small" Value="{Binding ContourMzTo}" Minimum="0" Increment="10" FormatString="0.##" Width="108" ToolTip.Tip="Upper m/z of the surface; 0 for the channel's own range" />
                  <Button Classes="tool" Content="Rebuild" Click="OnRebuildContour" ToolTip.Tip="Rebuild the grid over the time range on screen and the m/z range typed here, at full resolution" />
                  <Button Classes="tool" Content="Extract this view" Click="OnExtractContourView" ToolTip.Tip="The chromatogram and the spectrum of the rectangle on screen, read from the reader" />
                  <TextBlock Classes="hint" Text="{Binding ContourStatus}" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
              </Border>
              <c:ContourChart x:Name="Contour" Grid="{Binding Contour}" IntensityScale="{Binding ContourScale}" Colours="{Binding ContourColours}" MarkerRt="{Binding MarkerRt}" Title="{Binding ContourStatus}" />
            </DockPanel>
          </Grid>
        </Border>
        <GridSplitter Grid.Row="2" Classes="horizontal" ResizeDirection="Rows" />
        <Border Grid.Row="3" Padding="2,4,2,6">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Average selected range" Command="{Binding AverageSelectedRangeCommand}" IsEnabled="{Binding HasSelection}" />
            <Button DockPanel.Dock="Right" Classes="tool" Content="XIC from selection" Command="{Binding XicFromSelectionCommand}" IsEnabled="{Binding HasSpectrumSelection}" Margin="0,0,8,0" ToolTip.Tip="Extract the m/z range shaded on the spectrum (⇧-drag) as an XIC, exactly as selected" />
            <TextBlock DockPanel.Dock="Right" Classes="muted" Text="{Binding SelectionLabel}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBlock Classes="label" Text="Scan" />
            <Button Classes="icon" Content="◀" Command="{Binding PreviousScanCommand}" />
            <NumericUpDown x:Name="ScanBox" Value="{Binding ScanNumber, Mode=OneWay}" Minimum="1" Increment="1" FormatString="0" Width="124" MinHeight="26" ValueChanged="OnScanChanged" />
            <Button Classes="icon" Content="▶" Command="{Binding NextScanCommand}" />
            <TextBlock Classes="muted" Text="{Binding ScanCount, StringFormat=of {0}}" VerticalAlignment="Center" Margin="6,0,0,0" />
            <TextBlock Classes="muted" Text="{Binding ScanPrecursorLabel}" VerticalAlignment="Center" Margin="14,0,0,0" ToolTip.Tip="The precursor this scan isolated — per scan, for IDA slots and DDA events" />
          </DockPanel>
        </Border>
        <Border Grid.Row="4" Classes="panel">
          <c:SpectrumChart x:Name="Spectrum" Peaks="{Binding SpectrumPeaks}" ReferencePeaks="{Binding ReferencePeaks}" OverlayPeaks="{Binding OverlayPeaks}" PrecursorMz="{Binding PrecursorMz}" Title="{Binding SpectrumTitle}" TopLabels="{Binding TopLabels}"
                           SelectionStart="{Binding SpectrumSelectionStart, Mode=TwoWay}" SelectionEnd="{Binding SpectrumSelectionEnd, Mode=TwoWay}" />
        </Border>
      </Grid>
      <GridSplitter Grid.Column="3" Classes="vertical" ResizeDirection="Columns" />

      <!-- right: panels -->
      <Border Grid.Column="4" Classes="panel">
        <DockPanel>
          <Border DockPanel.Dock="Top" Padding="12,10,12,0">
            <TextBlock Classes="eyebrow" Text="PANELS" Margin="0" />
          </Border>
          <TabControl Classes="panel-tabs" Margin="6,0,6,6">
            <TabItem Header="Peaks">
              <DockPanel Margin="0,6,0,0">
                <TextBlock DockPanel.Dock="Top" Classes="hint" Text="{Binding PeaksTitle}" Margin="4,0,4,6" TextWrapping="Wrap" />
                <TextBox DockPanel.Dock="Top" Text="{Binding PeakFilter}" Watermark="Filter by name or m/z" Margin="0,0,0,6" />
                <DataGrid ItemsSource="{Binding FilteredPeaks}" SelectedItem="{Binding SelectedPeak}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="24">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="RT" Binding="{Binding Rt, StringFormat={}{0:F2}}" Width="54" />
                    <DataGridTextColumn Header="m/z" Binding="{Binding Mz, StringFormat={}{0:F4}}" Width="84" />
                    <DataGridTextColumn Header="Height" Binding="{Binding Height, StringFormat={}{0:N0}}" Width="80" />
                    <DataGridTextColumn Header="Score" Binding="{Binding Score, StringFormat={}{0:F2}}" Width="58" />
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </TabItem>
            <TabItem Header="Manual XIC">
              <DockPanel Margin="0,6,0,0">
                <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
                  <TextBlock Classes="hint" Text="Extract ion chromatograms of the active sample from the source below: MS1, a channel, every MS2 scan, or only the MS2 scans whose precursor was a given m/z." TextWrapping="Wrap" Margin="4,0" />
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Add" Command="{Binding AddXicCommand}" Margin="6,0,0,0" MinWidth="60" />
                    <TextBox Text="{Binding XicMzText}" Watermark="m/z, comma or space separated (183.1391, 313.2384)" />
                  </DockPanel>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="label" Text="Tolerance ±" />
                    <NumericUpDown Classes="small" Value="{Binding XicTolerance}" Minimum="0" Increment="0.005" FormatString="0.####" Width="120" />
                    <ComboBox Classes="compact" ItemsSource="{x:Static vm:ExplorerViewModel.ToleranceUnits}" SelectedItem="{Binding XicUnit}" Width="72" />
                    <Button Classes="tool" Content="Clear all" Command="{Binding ClearXicsCommand}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="label" Text="Source" />
                    <ComboBox Classes="compact" ItemsSource="{x:Static vm:ExplorerViewModel.XicSourceNames}" SelectedItem="{Binding XicSourceName}" Width="178" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding XicIsGated}">
                    <TextBlock Classes="label" Text="Precursor m/z" />
                    <NumericUpDown Classes="small" Value="{Binding XicGateMz}" Minimum="0" Increment="0.01" FormatString="0.####" Width="130" />
                    <TextBlock Classes="label" Text="± Da" />
                    <NumericUpDown Classes="small" Value="{Binding XicGateTolerance}" Minimum="0.001" Increment="0.01" FormatString="0.###" Width="96" />
                  </StackPanel>
                  <TextBlock Classes="hint" Text="{Binding XicSourceNote}" TextWrapping="Wrap" Margin="4,0" IsVisible="{Binding XicSourceNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding XicEntries}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ManualXic">
                      <DockPanel>
                        <Button DockPanel.Dock="Right" Classes="icon" Content="✕" Command="{Binding $parent[UserControl].DataContext.RemoveXicCommand}" CommandParameter="{Binding}" />
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                      </DockPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </TabItem>
            <TabItem Header="Mass calc">
              <DockPanel Margin="0,6,0,0">
                <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
                  <TextBlock Classes="hint" Text="A formula into the numbers a mass spectrometrist needs, and a measured mass into an error. Groups, multipliers and single isotopes are read: C6H4(NO2)2, [13C]6H12O6, C18H30D4O4." TextWrapping="Wrap" Margin="4,0" />
                  <DockPanel>
                    <ComboBox DockPanel.Dock="Right" Classes="compact" ItemsSource="{x:Static vm:ExplorerViewModel.AdductNames}" SelectedItem="{Binding AdductName}" Width="118" Margin="6,0,0,0" />
                    <TextBox Text="{Binding FormulaText}" Watermark="Formula (C18H34O4)" />
                  </DockPanel>
                  <TextBlock Classes="hint" Text="{Binding FormulaStatus}" TextWrapping="Wrap" Margin="4,0" IsVisible="{Binding FormulaStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <ItemsControl ItemsSource="{Binding MassSummary}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:MassSummaryRow">
                        <DockPanel Margin="4,1">
                          <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontFamily="{StaticResource OdMonoFont}" />
                          <TextBlock Classes="muted" Text="{Binding Name}" />
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Classes="tool" Content="Measured from spectrum" Command="{Binding MeasuredFromSpectrumCommand}" Margin="6,0,0,0" ToolTip.Tip="Take the measured m/z from the spectrum pane: the peak nearest the theoretical ion" />
                    <TextBlock DockPanel.Dock="Left" Classes="label" Text="Measured m/z" />
                    <TextBox Text="{Binding MeasuredMzText}" Watermark="measured m/z" Margin="6,0,0,0" />
                  </DockPanel>
                  <TextBlock Text="{Binding MassError}" FontFamily="{StaticResource OdMonoFont}" Margin="4,0" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Classes="tool" Content="Overlay on spectrum" Command="{Binding OverlayIsotopesCommand}" ToolTip.Tip="Draw the theoretical isotope pattern on the spectrum pane, scaled to the measured peak nearest the monoisotopic m/z" />
                    <Button Classes="tool" Content="Clear overlay" Command="{Binding ClearOverlayCommand}" />
                  </StackPanel>
                </StackPanel>
                <DataGrid ItemsSource="{Binding IsotopeRows}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="24">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="m/z" Binding="{Binding Mz, StringFormat={}{0:F5}}" Width="*" />
                    <DataGridTextColumn Header="Rel. %" Binding="{Binding Abundance, StringFormat={}{0:F2}}" Width="80" />
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </TabItem>
            <TabItem Header="Spectrum peaks">
              <DataGrid Margin="0,6,0,0" ItemsSource="{Binding SpectrumTable}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="24" DoubleTapped="OnSpectrumPeakDoubleTapped" ToolTip.Tip="Double-click a row to extract its m/z as an XIC">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="m/z" Binding="{Binding Mz, StringFormat={}{0:F4}}" Width="*" />
                  <DataGridTextColumn Header="Intensity" Binding="{Binding Intensity, Converter={x:Static views:Converters.Number}, ConverterParameter=N0}" Width="100" />
                  <DataGridTextColumn Header="Rel. %" Binding="{Binding Relative, StringFormat={}{0:F1}}" Width="70" />
                </DataGrid.Columns>
              </DataGrid>
            </TabItem>
          </TabControl>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
