<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MilX.Desktop</RootNamespace>
    <AssemblyName>MIL-X</AssemblyName>
    <ApplicationIcon />
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <Configurations>Debug;Release;Debug vendor unsupported;Release vendor unsupported</Configurations>
    <NoWarn>$(NoWarn);CS0618</NoWarn>
    <!-- output folder of the native SCIEX .wiff plugin; its files are mirrored into <app>/plugins/sciex after the build -->
    <SciexPluginDir>$(MSBuildThisFileDirectory)../MilX.Plugins.SciexWiff/bin/$(Configuration)/net8.0/</SciexPluginDir>
  </PropertyGroup>

  <PropertyGroup Condition="$(Configuration.StartsWith('Debug'))">
    <DefineConstants>$(DefineConstants);DEBUG</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Theme.axaml/AppStyles.axaml are picked up by Avalonia's default glob; the icon is not. -->
    <AvaloniaResource Include="Assets/icon.png" />
    <!--
      The monospace face is carried rather than borrowed. Menlo exists on macOS, Consolas on
      Windows and DejaVu on most Linuxes, and each has different advance widths, so a table of
      numbers laid out on one machine does not line up on another. JetBrains Mono NL is under the
      Open Font License (Assets/Fonts/OFL.txt); no ligatures, which is what a column of masses wants.
    -->
    <AvaloniaResource Include="Assets/Fonts/JetBrainsMonoNL-Regular.ttf" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The manual travels inside the application. The pages under docs/manual are the source of both
      the Help window and the PDF, so there is one manual; embedding them means the help is the help
      of the build that is running rather than of whatever is on disk.
    -->
    <EmbeddedResource Include="..\..\docs\manual\*.md" LogicalName="Manual/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\docs\manual\pt\*.md" LogicalName="Manual/pt/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\docs\images\*.png" LogicalName="Manual/images/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MilX.Desktop.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.13" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.13" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.13" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.13" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.13" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.13" Condition="$(Configuration.StartsWith('Debug'))" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MilX.Pipeline\MilX.Pipeline.csproj" />
    <ProjectReference Include="..\MilX.Interop.OpenQuant\MilX.Interop.OpenQuant.csproj" />
    <!-- build the plugin first; it is consumed through MilX.Pipeline and mirrored into plugins/sciex below -->
    <ProjectReference Include="..\MilX.Plugins.SciexWiff\MilX.Plugins.SciexWiff.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!--
    Mirror the SCIEX plugin (reader + Clearcore2 SDK + licence text) into <app>/plugins/sciex, where
    MilX.RawData discovers raw-file readers. Assemblies the app already ships are excluded so the
    plugin folder never shadows the app's own copies.
  -->
  <Target Name="CopySciexPlugin" AfterTargets="Build" Condition="Exists('$(SciexPluginDir)')">
    <ItemGroup>
      <SciexPluginFile Include="$(SciexPluginDir)*.dll;$(SciexPluginDir)*.txt"
                       Exclude="$(SciexPluginDir)Common.dll;$(SciexPluginDir)MilX.RawData.dll;$(SciexPluginDir)NCDK.dll;$(SciexPluginDir)MessagePack*.dll;$(SciexPluginDir)Accord*.dll;$(SciexPluginDir)Newtonsoft.Json.dll;$(SciexPluginDir)Splash.dll;$(SciexPluginDir)MathNet.Numerics.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(SciexPluginFile)" DestinationFolder="$(OutDir)plugins/sciex/" SkipUnchangedFiles="true" ContinueOnError="true" />
  </Target>

</Project>
